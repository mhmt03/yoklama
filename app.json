{
  "expo": {
    "name": "yoklama",
    "slug": "yoklama",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/derstakip-icon.png",
    "userInterfaceStyle": "light",
     "extra": {
      "eas": {
        "projectId": "fcd7aa84-990e-4397-89ba-b1ea55b083f0"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mhmt03.yoklama"
    },
    "android": {
      "package": "com.mhmt03.yoklama",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ]
  }
}

@model yoklamaWeb.ViewModels.Pansiyon.YoklamaListViewModel
@{
    var ogrenci = ViewBag.Ogrenci as yoklamaWeb.Models.PansiyonOgrenci;
    ViewData["Title"] = $"{ogrenci?.AdSoyad} Yoklama Geçmişi";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="mb-3">
        <a asp-controller="PansiyonOgrenci" asp-action="Details" asp-route-id="@ogrenci?.Id" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Öğrenci Profiline Dön</a>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>@ogrenci?.AdSoyad Yoklama Geçmişi</h2>
        <span class="badge bg-secondary p-2">Öğrenci No: @ogrenci?.OgrenciNo</span>
    </div>

    <div class="card mb-4 shadow-sm border-0 bg-light">
        <div class="card-body">
            <form method="get" asp-action="OgrenciYoklamalari" asp-route-id="@ogrenci?.Id" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">Durum</label>
                    <select name="Durum" asp-items="ViewBag.Durumlar" class="form-select">
                        <option value="">-- Tümü --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Başlangıç Tarihi</label>
                    <input type="date" name="BaslangicTarihi" value="@(Model.Filter.BaslangicTarihi?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Bitiş Tarihi</label>
                    <input type="date" name="BitisTarihi" value="@(Model.Filter.BitisTarihi?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-secondary w-100">Filtrele</button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th class="ps-3">Tarih / Saat</th>
                    <th>Durum</th>
                    <th>Yoklamayı Alan</th>
                    <th>Açıklama</th>
                    <th class="text-end pe-3">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Yoklamalar.Any())
                {
                    @foreach (var y in Model.Yoklamalar)
                    {
                        <tr>
                            <td class="ps-3">@y.Tarih.ToString("dd.MM.yyyy") @(y.Saat?.ToString(@"hh\:mm") ?? "")</td>
                            <td>
                                @if (y.Durum == "Var")
                                {
                                    <span class="badge bg-success">Var</span>
                                }
                                else if (y.Durum == "Yok")
                                {
                                    <span class="badge bg-danger">Yok</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@y.Durum</span>
                                }
                            </td>
                            <td>@y.YoklamaYapanAdSoyad</td>
                            <td>@(y.Aciklama ?? "-")</td>
                            <td class="text-end pe-3">
                                <a asp-action="Details" asp-route-id="@y.Id" class="btn btn-sm btn-info me-1"><i class="bi bi-eye"></i> Detay</a>
                                <a asp-action="Edit" asp-route-id="@y.Id" class="btn btn-sm btn-warning me-1"><i class="bi bi-pencil"></i> Düzenle</a>
                                <a asp-action="Delete" asp-route-id="@y.Id" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Sil</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Öğrenciye ait filtreye uygun yoklama bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@model yoklamaWeb.ViewModels.Pansiyon.YoklamaListViewModel
@{
    ViewData["Title"] = "Yoklama Geçmişi ve Listesi";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Yoklama Listesi & Geçmişi</h2>
        <a asp-action="GunlukYoklama" class="btn btn-success"><i class="bi bi-plus-lg"></i> Günlük Yoklama Al</a>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Arama</label>
                    <input type="text" name="Arama" value="@Model.Filter.Arama" class="form-control" placeholder="Öğrenci adı, no..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Başlangıç Tarihi</label>
                    <input type="date" name="BaslangicTarihi" value="@(Model.Filter.BaslangicTarihi?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Bitiş Tarihi</label>
                    <input type="date" name="BitisTarihi" value="@(Model.Filter.BitisTarihi?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-secondary w-100">Filtrele</button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Tarih / Saat</th>
                    <th>Öğrenci No</th>
                    <th>Ad Soyad</th>
                    <th>Durum</th>
                    <th>Yoklamayı Alan</th>
                    <th>Açıklama</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Yoklamalar.Any())
                {
                    @foreach (var y in Model.Yoklamalar)
                    {
                        <tr>
                            <td>@y.Tarih.ToString("dd.MM.yyyy") @(y.Saat?.ToString(@"hh\:mm") ?? "")</td>
                            <td>@y.OgrenciNo</td>
                            <td><strong>@y.OgrenciAdSoyad</strong></td>
                            <td>
                                @if (y.Durum == "Var")
                                {
                                    <span class="badge bg-success">Var</span>
                                }
                                else if (y.Durum == "Yok")
                                {
                                    <span class="badge bg-danger">Yok</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@y.Durum</span>
                                }
                            </td>
                            <td>@y.YoklamaYapanAdSoyad</td>
                            <td>@(y.Aciklama ?? "-")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@y.Id" class="btn btn-sm btn-info"><i class="bi bi-eye"></i> Detay</a>
                                <a asp-action="Edit" asp-route-id="@y.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i> Düzenle</a>
                                <a asp-action="Delete" asp-route-id="@y.Id" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Sil</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Kayıtlı yoklama bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

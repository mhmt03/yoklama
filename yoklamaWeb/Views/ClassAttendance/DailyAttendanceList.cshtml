@model IEnumerable<yoklamaWeb.Models.DailyClassAttendance>
@{
    ViewData["Title"] = "Günlük Yoklama Listeleri";
    Layout = "_Layout";
    var templates = (List<yoklamaWeb.Models.ClassAttendance>)ViewBag.Templates;
    var selectedTemplateId = (int?)ViewBag.SelectedTemplateId;
    var dateFilter = (string)ViewBag.DateFilter;
}

<div class="container mt-4">
    <div class="d-flex flex-column flex-md-row align-items-start justify-content-between gap-3 mb-4">
        <div>
            <h2 class="mb-1" style="font-family: 'Outfit', sans-serif; color: #2c3e50;">Günlük Sınıf Yoklama Listeleri</h2>
            <p class="text-muted mb-0">Oluşturulan günlük yoklama oturumlarını görüntüleyin ve yönetin.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <!-- Filtre Kartı -->
    <div class="card mb-4 p-3 border-0 shadow-sm">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Tarih</label>
                <input type="date" name="dateFilter" value="@dateFilter" class="form-control" />
            </div>
            <div class="col-md-5">
                <label class="form-label">Sınıf Yoklama Planı</label>
                <select name="classAttendanceId" class="form-select">
                    <option value="">Tümü</option>
                    @if (templates != null)
                    {
                        @foreach (var temp in templates)
                        {
                            <option value="@temp.Id" selected="@(temp.Id == selectedTemplateId ? "selected" : null)">@temp.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-outline-primary w-100">Listele</button>
            </div>
        </form>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info m-4 mb-4">Oluşturulmuş günlük yoklama listesi bulunamadı.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Tarih</th>
                                <th>Yoklama Planı</th>
                                <th>Öğrenci Sayısı</th>
                                <th style="width: 250px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var ogrenciSayisi = item.Students.Any() ? item.Students.Where(s => s.OturumNo == 1).Count() : 0;
                                <tr>
                                    <td>
                                        <strong>@item.Tarih.ToString("dd.MM.yyyy")</strong>
                                    </td>
                                    <td>
                                        @item.ClassAttendance?.Name
                                    </td>
                                    <td>
                                        <span class="badge bg-primary p-2">@ogrenciSayisi Öğrenci</span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-action="DailyAttendance" asp-route-tarih="@item.Tarih.ToString("yyyy-MM-dd")" asp-route-classAttendanceId="@item.ClassAttendanceId" class="btn btn-sm btn-info text-white">
                                                <i class="bi bi-pencil-square"></i> Yoklama Al
                                            </a>
                                            @if (User.IsInRole("Admin") || User.IsInRole("Idareci") || User.IsInRole("SinavYoneticisi"))
                                            {
                                                <form asp-action="DeleteDailyAttendance" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu günlük yoklama oturumunu ve tüm girilen yoklama verilerini silmek istediğinize emin misiniz?');" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash"></i> Sil
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

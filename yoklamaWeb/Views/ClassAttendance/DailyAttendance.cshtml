@model yoklamaWeb.Models.DailyClassAttendance
@{
    ViewData["Title"] = "Günlük Sınıf Yoklaması Al";
    Layout = "_Layout";
    var templates = (List<yoklamaWeb.Models.ClassAttendance>)ViewBag.Templates;
    var selectedTemplateId = (int)ViewBag.SelectedTemplateId;
    var selectedTarih = (DateTime)ViewBag.SelectedTarih;
    var availableSessions = (List<int>)ViewBag.AvailableSessions;
    var selectedOturum = (int)ViewBag.SelectedOturum;

    var total = Model?.Students?.Count ?? 0;
    var varCount = Model?.Students?.Count(s => s.Durum == "Var") ?? 0;
    var yokCount = Model?.Students?.Count(s => s.Durum == "Yok") ?? 0;
    var izinliCount = Model?.Students?.Count(s => s.Durum == "İzinli") ?? 0;
    var gecCount = Model?.Students?.Count(s => s.Durum == "Geç") ?? 0;
    var belirsizCount = Model?.Students?.Count(s => s.Durum == "Belirsiz" || s.Durum == "blrsiz") ?? 0;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold mb-0" style="font-family: 'Outfit', sans-serif; color: #2c3e50;">Günlük Sınıf Yoklaması</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (User.IsInRole("gunlukYoklamaci") && ViewBag.TodaysProgramInfo != null)
    {
        var progList = (List<string>)ViewBag.TodaysProgramInfo;
        <div class="alert alert-info rounded-4 shadow-sm border-0 mb-3 py-2 px-3 small d-flex flex-wrap align-items-center gap-2">
            <div><i class="bi bi-calendar-check-fill text-primary me-1"></i> <strong>Bugün Bulunacağınız Sınıflar/Salonlar:</strong></div>
            <div class="d-flex flex-wrap gap-1">
                @if (progList.Any())
                {
                    @foreach (var prog in progList)
                    {
                        <span class="badge bg-primary">@prog</span>
                    }
                }
                else
                {
                    <span class="text-muted">Bugün için atanmış dersiniz bulunmuyor.</span>
                }
            </div>
        </div>
    }

    <!-- Filtre Kartı -->
    <div class="card mb-4 shadow-sm border-0 bg-light sticky-top" style="top: 56px; z-index: 990; border-radius: 12px;">
        <div class="card-body p-3">
            <form method="get" asp-action="DailyAttendance" id="filterForm" class="row g-2 align-items-end">
                <div class="col-md-3 col-sm-6">
                    <label class="form-label fw-bold small mb-1"><i class="bi bi-calendar3"></i> Tarih</label>
                    <input type="date" name="tarih" value="@selectedTarih.ToString("yyyy-MM-dd")" class="form-control form-control-sm" onchange="this.form.submit()" />
                </div>
                <div class="col-md-4 col-sm-6">
                    <label class="form-label fw-bold small mb-1"><i class="bi bi-house-door"></i> Sınıf Yoklama Planı</label>
                    <select name="classAttendanceId" class="form-select form-select-sm" onchange="this.form.submit()">
                        @if (templates != null)
                        {
                            @foreach (var temp in templates)
                            {
                                <option value="@temp.Id" selected="@(temp.Id == selectedTemplateId ? "selected" : null)">@temp.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label fw-bold small mb-1"><i class="bi bi-list-ol"></i> Yoklama Seçimi (Oturum)</label>
                    <select name="oturumNo" class="form-select form-select-sm" onchange="this.form.submit()">
                        @if (availableSessions != null && availableSessions.Any())
                        {
                            @foreach (var o in availableSessions)
                            {
                                <option value="@o" selected="@(o == selectedOturum ? "selected" : null)">@o. Oturum</option>
                            }
                        }
                        else
                        {
                            <option value="1">1. Oturum (Kayıt yok)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 col-sm-6">
                    <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-arrow-repeat"></i> Getir</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model == null)
    {
        <div class="alert alert-warning shadow-sm border-0 rounded-4">
            <h5 class="fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Yoklama Bulunamadı</h5>
            <p class="mb-0">Seçilen tarih, plan ve oturum için henüz günlük yoklama listesi oluşturulmamış. Yeni liste oluşturmak için 
                <a asp-action="Index" class="fw-bold alert-link">Sınıf Yoklama Planları</a> sayfasına gidip planın detayından <strong>Günlük Yoklama Listesi Oluştur</strong> seçeneğini kullanabilirsiniz.
            </p>
        </div>
    }
    else
    {
        <!-- Statistics -->
        <div class="d-flex mb-4 gap-2 flex-wrap">
            <div class="p-2 bg-primary text-white rounded text-center flex-fill" style="min-width: 80px;">
                <small class="d-block opacity-75">Toplam</small>
                <strong class="fs-5">@total</strong>
            </div>
            <div class="p-2 bg-success text-white rounded text-center flex-fill" style="min-width: 80px;">
                <small class="d-block opacity-75">Var</small>
                <strong class="fs-5">@varCount</strong>
            </div>
            <div class="p-2 bg-danger text-white rounded text-center flex-fill" style="min-width: 80px;">
                <small class="d-block opacity-75">Yok</small>
                <strong class="fs-5">@yokCount</strong>
            </div>
            <div class="p-2 bg-warning text-dark rounded text-center flex-fill" style="min-width: 80px;">
                <small class="d-block opacity-75">İzinli</small>
                <strong class="fs-5">@izinliCount</strong>
            </div>
            <div class="p-2 bg-info text-dark rounded text-center flex-fill" style="min-width: 80px;">
                <small class="d-block opacity-75">Geç</small>
                <strong class="fs-5">@gecCount</strong>
            </div>
            <div class="p-2 bg-secondary text-white rounded text-center flex-fill" style="min-width: 80px;">
                <small class="d-block opacity-75">Belirsiz</small>
                <strong class="fs-5">@belirsizCount</strong>
            </div>
        </div>

        <!-- Interactive Filters -->
        <div class="row g-2 mb-3 bg-light p-3 rounded-4 shadow-sm border">
            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1 text-secondary"><i class="bi bi-search"></i> Öğrenci Ara</label>
                <input id="nameFilter" type="text" class="form-control form-control-sm" placeholder="Ad Soyad veya No..." oninput="applyFilters()" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1 text-secondary"><i class="bi bi-funnel"></i> Sınıf Filtresi</label>
                <select id="classFilter" class="form-select form-select-sm" onchange="applyFilters()">
                    <option value="">Tümü</option>
                    @foreach (var val in Model.Students.Select(s => s.SinifDuzeyi).Distinct().OrderBy(x => x))
                    {
                        <option value="@val">@val</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1 text-secondary"><i class="bi bi-funnel"></i> Şube Filtresi</label>
                <select id="subeFilter" class="form-select form-select-sm" onchange="applyFilters()">
                    <option value="">Tümü</option>
                    @foreach (var val in Model.Students.Select(s => s.Sube).Distinct().OrderBy(x => x))
                    {
                        <option value="@val">@val</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold mb-1 text-secondary"><i class="bi bi-funnel"></i> Salon Filtresi</label>
                <select id="salonFilter" class="form-select form-select-sm" onchange="applyFilters()">
                    <option value="">Tümü</option>
                    @foreach (var val in Model.Students.Select(s => s.Salon).Where(x => !string.IsNullOrEmpty(x)).Distinct().OrderBy(x => x))
                    {
                        <option value="@val">@val</option>
                    }
                </select>
            </div>
        </div>

        @if (ViewBag.IsAuthorized == false)
        {
            <div class="alert alert-warning rounded-4 shadow-sm border-0 mb-4 d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill fs-4 text-warning"></i>
                <div>
                    <strong>Yetki Sınırı:</strong> Bu oturumda (yoklamada) ders programınız bulunmamaktadır. Yoklama listesini sadece inceleyebilirsiniz.
                </div>
            </div>
        }

        @if ((User.IsInRole("Admin") || User.IsInRole("Idareci") || User.IsInRole("SinavYoneticisi") || User.IsInRole("SuperYoklamaci")) && !string.IsNullOrEmpty(ViewBag.SubmittedBy))
        {
            <div class="alert alert-info rounded-4 shadow-sm border-0 mb-4 py-2 px-3 small d-flex align-items-center justify-content-between">
                <div>
                    <i class="bi bi-info-circle-fill me-1"></i> Son Yoklamayı Alan: <strong>@ViewBag.SubmittedByFullName (@ViewBag.SubmittedBy)</strong>
                </div>
                <div>
                    Kayıt Zamanı: <strong>@ViewBag.SubmittedAt</strong>
                </div>
            </div>
        }

        <form method="post" asp-action="SaveDailyAttendance">
            @Html.AntiForgeryToken()
            <input type="hidden" name="dailyAttendanceId" value="@Model.Id" />
            <input type="hidden" name="oturumNo" value="@selectedOturum" />

            <!-- Bulk Actions for Visible Students -->
            @if (ViewBag.IsAuthorized == true)
            {
                <div class="d-flex gap-2 mb-3 align-items-center bg-light p-2 rounded-3 border">
                    <span class="text-secondary small fw-bold"><i class="bi bi-check-all"></i> Toplu Yoklama İşlemleri (Filtrelenmiş):</span>
                    <button type="button" class="btn btn-sm btn-success px-3 fw-bold" onclick="markAllVisible('Var')">Tümü Var</button>
                    <button type="button" class="btn btn-sm btn-danger px-3 fw-bold" onclick="markAllVisible('Yok')">Tümü Yok</button>
                    <button type="button" class="btn btn-sm btn-secondary px-3 fw-bold" onclick="markAllVisible('Belirsiz')">Tümü Belirsiz</button>
                </div>
            }

            <style>
                @@media (max-width: 767.98px) {
                    .table-responsive table thead {
                        display: none;
                    }
                    #studentTableBody tr {
                        display: block;
                        padding: 12px 10px;
                        border-bottom: 1.5px solid #dee2e6;
                    }
                    #studentTableBody tr td {
                        display: inline-block;
                        padding: 2px 0 !important;
                        border: none !important;
                        margin-right: 8px;
                        vertical-align: middle;
                    }
                    #studentTableBody tr td:nth-child(1) {
                        font-weight: bold;
                    }
                    #studentTableBody tr td:nth-child(2) {
                        display: inline;
                        font-weight: 600;
                    }
                    #studentTableBody tr td:nth-child(3),
                    #studentTableBody tr td:nth-child(4) {
                        font-size: 0.85rem;
                    }
                    /* Move Durum and Not to separate lines */
                    #studentTableBody tr td:nth-child(5),
                    #studentTableBody tr td:nth-child(6) {
                        display: block;
                        margin-top: 8px;
                        margin-right: 0;
                        width: 100%;
                    }
                    #studentTableBody tr td:nth-child(5) .btn-group {
                        display: flex;
                        width: 100%;
                    }
                    #studentTableBody tr td:nth-child(5) .btn-group .btn {
                        flex: 1;
                        padding: 6px 2px;
                        font-size: 0.75rem;
                    }
                }
            </style>

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 140px; cursor: pointer;" onclick="sortTable(0)">Öğrenci No <i class="bi bi-arrow-down-up ms-1 text-muted"></i></th>
                                <th style="cursor: pointer;" onclick="sortTable(1)">Ad Soyad <i class="bi bi-arrow-down-up ms-1 text-muted"></i></th>
                                <th style="cursor: pointer;" onclick="sortTable(2)">Sınıf/Şube <i class="bi bi-arrow-down-up ms-1 text-muted"></i></th>
                                <th style="cursor: pointer;" onclick="sortTable(3)">Salon/Sıra <i class="bi bi-arrow-down-up ms-1 text-muted"></i></th>
                                <th>Durum</th>
                                <th>Öğrenci Notu</th>
                            </tr>
                        </thead>
                        <tbody id="studentTableBody">
                            @{
                                var teacherAssignedSalons = (List<string>)ViewBag.TeacherAssignedSalons;
                                bool globalAuth = (bool)ViewBag.IsAuthorized;
                            }
                            @for (int i = 0; i < Model.Students.Count; i++)
                            {
                                var student = Model.Students[i];
                                bool isStudentEditable = globalAuth;
                                if (isStudentEditable && User.IsInRole("gunlukYoklamaci") && teacherAssignedSalons != null)
                                {
                                    isStudentEditable = teacherAssignedSalons.Contains(student.Salon ?? "");
                                }

                                <tr data-no="@student.OgrenciNo" data-ad="@student.AdSoyad" data-class="@student.SinifDuzeyi" data-sube="@student.Sube" data-salon="@(student.Salon ?? "")" data-sira="@(student.Sira ?? "")" style="@(!isStudentEditable && User.IsInRole("gunlukYoklamaci") ? "opacity: 0.6;" : "")">
                                    <td>
                                        <strong>@student.OgrenciNo</strong>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@student.AdSoyad</span>
                                    </td>
                                    <td>
                                        @student.SinifDuzeyi - @student.Sube
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark">S: @(student.Salon ?? "-")</span>
                                        <span class="badge bg-light text-dark">Sıra: @(student.Sira ?? "-")</span>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <input type="radio" class="btn-check" name="studentDurum[@student.Id]" id="blrsiz_@student.Id" value="Belirsiz" @(student.Durum == "Belirsiz" || student.Durum == "blrsiz" ? "checked" : "") @(!isStudentEditable ? "disabled" : "") />
                                            <label class="btn btn-outline-secondary" for="blrsiz_@student.Id">Belirsiz</label>

                                            <input type="radio" class="btn-check" name="studentDurum[@student.Id]" id="var_@student.Id" value="Var" @(student.Durum == "Var" ? "checked" : "") @(!isStudentEditable ? "disabled" : "") />
                                            <label class="btn btn-outline-success" for="var_@student.Id">Var</label>

                                            <input type="radio" class="btn-check" name="studentDurum[@student.Id]" id="yok_@student.Id" value="Yok" @(student.Durum == "Yok" ? "checked" : "") @(!isStudentEditable ? "disabled" : "") />
                                            <label class="btn btn-outline-danger" for="yok_@student.Id">Yok</label>

                                            <input type="radio" class="btn-check" name="studentDurum[@student.Id]" id="izinli_@student.Id" value="İzinli" @(student.Durum == "İzinli" ? "checked" : "") @(!isStudentEditable ? "disabled" : "") />
                                            <label class="btn btn-outline-warning" for="izinli_@student.Id">İzinli</label>

                                            <input type="radio" class="btn-check" name="studentDurum[@student.Id]" id="gec_@student.Id" value="Geç" @(student.Durum == "Geç" ? "checked" : "") @(!isStudentEditable ? "disabled" : "") />
                                            <label class="btn btn-outline-info" for="gec_@student.Id">Geç</label>
                                        </div>
                                    </td>
                                    <td>
                                        <input type="text" name="studentNot[@student.Id]" value="@student.Not" class="form-control form-control-sm" placeholder="Not ekle..." @(!isStudentEditable ? "disabled" : "") />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Notes and Save -->
            <div class="card shadow-sm border-0 rounded-4 p-4 mb-5">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="salonNotu" class="form-label fw-bold">Salon Notu</label>
                        <textarea id="salonNotu" name="salonNotu" class="form-control" rows="3" placeholder="Sınav salonu ile ilgili notlar..." @(!globalAuth ? "disabled" : "")>@Model.SalonNotu</textarea>
                    </div>
                    <div class="col-md-6">
                        <label for="gozetmenNotu" class="form-label fw-bold">Gözetmen Notu</label>
                        <textarea id="gozetmenNotu" name="gozetmenNotu" class="form-control" rows="3" placeholder="Gözetmen notları veya yoklama açıklaması..." @(!globalAuth ? "disabled" : "")>@Model.GozetmenNotu</textarea>
                    </div>
                    <div class="col-12 text-end mt-3">
                        @if (globalAuth)
                        {
                            <button type="submit" class="btn btn-primary btn-lg px-5 fw-bold shadow-sm" style="border-radius: 10px;">
                                <i class="bi bi-save me-1"></i> Yoklamayı Kaydet
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary btn-lg px-5 fw-bold shadow-sm disabled" style="border-radius: 10px;">
                                <i class="bi bi-lock me-1"></i> Yoklama Kaydı Kilitli
                            </button>
                        }
                    </div>
                </div>
            </div>
        </form>

        <script>
            function applyFilters() {
                const nameVal = document.getElementById("nameFilter").value.toLocaleUpperCase('tr-TR');
                const classVal = document.getElementById("classFilter").value.toUpperCase();
                const subeVal = document.getElementById("subeFilter").value.toUpperCase();
                const salonVal = document.getElementById("salonFilter").value.toUpperCase();

                const rows = document.querySelectorAll("#studentTableBody tr");
                rows.forEach(row => {
                    const adText = row.getAttribute("data-ad").toLocaleUpperCase('tr-TR');
                    const noText = row.getAttribute("data-no").toLocaleUpperCase('tr-TR');
                    const classText = row.getAttribute("data-class").toUpperCase();
                    const subeText = row.getAttribute("data-sube").toUpperCase();
                    const salonText = row.getAttribute("data-salon").toUpperCase();

                    const nameMatch = !nameVal || adText.includes(nameVal) || noText.includes(nameVal);
                    const classMatch = !classVal || classText === classVal;
                    const subeMatch = !subeVal || subeText === subeVal;
                    const salonMatch = !salonVal || salonText === salonVal;

                    if (nameMatch && classMatch && subeMatch && salonMatch) {
                        row.style.display = "";
                    } else {
                        row.style.display = "none";
                    }
                });
            }

            let sortDirections = [true, true, true, true];
            function sortTable(columnIndex) {
                const tbody = document.getElementById("studentTableBody");
                const rows = Array.from(tbody.querySelectorAll("tr"));
                const direction = sortDirections[columnIndex];
                sortDirections[columnIndex] = !direction;

                rows.sort((a, b) => {
                    let aVal = "";
                    let bVal = "";

                    if (columnIndex === 0) {
                        aVal = a.getAttribute("data-no");
                        bVal = b.getAttribute("data-no");
                        const aNum = parseInt(aVal, 10);
                        const bNum = parseInt(bVal, 10);
                        if (!isNaN(aNum) && !isNaN(bNum)) {
                            return direction ? aNum - bNum : bNum - aNum;
                        }
                    } else if (columnIndex === 1) {
                        aVal = a.getAttribute("data-ad");
                        bVal = b.getAttribute("data-ad");
                    } else if (columnIndex === 2) {
                        aVal = a.getAttribute("data-class") + " " + a.getAttribute("data-sube");
                        bVal = b.getAttribute("data-class") + " " + b.getAttribute("data-sube");
                    } else if (columnIndex === 3) {
                        aVal = a.getAttribute("data-salon") + " " + a.getAttribute("data-sira");
                        bVal = b.getAttribute("data-salon") + " " + b.getAttribute("data-sira");
                    }

                    return direction 
                        ? aVal.localeCompare(bVal, 'tr', { sensitivity: 'base' })
                        : bVal.localeCompare(aVal, 'tr', { sensitivity: 'base' });
                });

                tbody.innerHTML = "";
                rows.forEach(row => tbody.appendChild(row));
            }

            function markAllVisible(status) {
                const rows = document.querySelectorAll("#studentTableBody tr");
                rows.forEach(row => {
                    if (row.style.display !== "none") {
                        const radios = row.querySelectorAll(".btn-check");
                        radios.forEach(radio => {
                            if (!radio.disabled && radio.value === status) {
                                radio.checked = true;
                            }
                        });
                    }
                });
            }
        </script>
    }
</div>

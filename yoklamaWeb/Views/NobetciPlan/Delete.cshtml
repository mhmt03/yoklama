@model yoklamaWeb.ViewModels.Pansiyon.NobetciPlanViewModel
@{
    ViewData["Title"] = "Nöbet Planı Sil";
    Layout = "_Layout";
}

<div class="container mt-4" style="max-width: 500px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0 fw-bold">Nöbet Planı Silme Onayı</h4>
        </div>
        <div class="card-body p-4 text-center">
            <div class="mb-4">
                <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
            </div>
            
            <p class="lead"><strong>@Model.GorevliAdSoyad</strong> isimli görevlinin <strong>@Model.Gun</strong> gününe ait nöbet planını silmek istediğinizden emin misiniz?</p>
            
            <div class="alert alert-warning text-start small">
                <strong>Detaylar:</strong>
                <ul>
                    <li>Tarih Aralığı: @Model.BaslangicTarihi.ToString("dd.MM.yyyy") - @Model.BitisTarihi.ToString("dd.MM.yyyy")</li>
                </ul>
            </div>

            <form method="post" asp-action="Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="RowVersion" />

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
                    <button type="submit" class="btn btn-danger fw-semibold">Evet, Sil</button>
                </div>
            </form>
        </div>
    </div>
</div>

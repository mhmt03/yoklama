@model yoklamaWeb.Models.GunlukYoklamaci
@{
    ViewData["Title"] = "Yoklamaci Düzenle";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h3 class="card-title fw-bold text-center mb-3" style="font-family: 'Outfit', sans-serif; color: #2c3e50;">Yoklamacı Bilgilerini Düzenle</h3>
                    <p class="text-center text-muted mb-4">Öğretmenin bilgilerini güncelleyebilirsiniz.</p>

                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="AdSoyad" class="form-label fw-semibold">Ad Soyad</label>
                            <input asp-for="AdSoyad" class="form-control" required />
                            <span asp-validation-for="AdSoyad" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="KullaniciAdi" class="form-label fw-semibold">Kullanıcı Adı</label>
                            <input asp-for="KullaniciAdi" class="form-control" required />
                            <span asp-validation-for="KullaniciAdi" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Sifre" class="form-label fw-semibold">Giriş Şifresi</label>
                            <input asp-for="Sifre" class="form-control" type="text" required />
                            <span asp-validation-for="Sifre" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Brans" class="form-label fw-semibold">Branş</label>
                            <input asp-for="Brans" class="form-control" required />
                            <span asp-validation-for="Brans" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between gap-3 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-left"></i> Geri Dön</a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold"><i class="bi bi-check-circle"></i> Değişiklikleri Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

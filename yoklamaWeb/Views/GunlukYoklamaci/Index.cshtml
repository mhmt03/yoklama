@model IEnumerable<yoklamaWeb.Models.GunlukYoklamaci>
@{
    ViewData["Title"] = "Günlük Yoklamacılar";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex flex-column flex-md-row align-items-start justify-content-between gap-3 mb-4">
        <div>
            <h2 class="mb-1" style="font-family: 'Outfit', sans-serif; color: #2c3e50;">Günlük Sınıf Yoklamacıları</h2>
            <p class="text-muted mb-0">Sisteme günlük sınıf yoklaması girecek öğretmenleri ve haftalık programlarını yönetin.</p>
        </div>
        <div class="d-flex gap-2 align-self-end flex-wrap">
            <button type="button" class="btn btn-outline-success fw-bold shadow-sm d-flex align-items-center gap-2" style="border-radius: 8px;" data-bs-toggle="modal" data-bs-target="#excelUploadModal">
                <i class="bi bi-file-earmark-excel-fill"></i> Toplu Program Yükle
            </button>
            <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm d-flex align-items-center gap-2" style="border-radius: 8px;">
                <i class="bi bi-person-plus-fill"></i> Yeni Yoklamacı Ekle
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search Form -->
    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body p-3">
            <form method="get" class="row g-2">
                <div class="col-md-9 col-sm-8">
                    <input type="text" name="arama" value="@ViewBag.Arama" class="form-control" placeholder="Ad Soyad, Kullanıcı Adı veya Branş ile ara..." />
                </div>
                <div class="col-md-3 col-sm-4">
                    <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> Ara</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info m-4">Kayıtlı günlük yoklamacı öğretmen bulunamadı.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Ad Soyad</th>
                                <th>Kullanıcı Adı</th>
                                <th>Branş</th>
                                <th style="width: 320px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-weight: bold;">
                                                @(item.AdSoyad.Length > 0 ? item.AdSoyad.Substring(0, 1).ToUpper() : "Y")
                                            </div>
                                            <span class="fw-semibold">@item.AdSoyad</span>
                                        </div>
                                    </td>
                                    <td>
                                        <code>@item.KullaniciAdi</code>
                                    </td>
                                    <td>
                                        @item.Brans
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-sm btn-info text-white" onclick="openScheduleModal(@item.Id, '@item.AdSoyad')">
                                                <i class="bi bi-calendar-week"></i> Program Belirle
                                            </button>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-pencil"></i> Düzenle
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Sil
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Ders Programı Popup Modal -->
<div class="modal fade" id="scheduleModal" tabindex="-1" aria-labelledby="scheduleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="scheduleModalLabel">Ders Programı Belirle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <input type="hidden" id="modalProctorId" />
                <p class="text-muted small mb-3"><i class="bi bi-info-circle-fill text-primary"></i> Her günün altına ders programındaki ilgili oturumlarda (yoklamalarda) öğretmenlerin bulunacağı sınav salonlarını seçiniz. Boş bırakılan oturumlar için ders programı kaydı oluşmaz.</p>
                
                <div class="table-responsive">
                    <table class="table table-bordered table-sm bg-white align-middle text-center shadow-sm rounded">
                        <thead class="table-secondary">
                            <tr>
                                <th style="width: 14%;">Pazartesi</th>
                                <th style="width: 14%;">Salı</th>
                                <th style="width: 14%;">Çarşamba</th>
                                <th style="width: 14%;">Perşembe</th>
                                <th style="width: 14%;">Cuma</th>
                                <th style="width: 14%;">Cumartesi</th>
                                <th style="width: 14%;">Pazar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int row = 1; row <= 8; row++)
                            {
                                <tr class="bg-light-subtle">
                                    <td colspan="7" class="fw-semibold text-start text-dark p-1 small" style="background-color: #f1f2f6;">@row. Yoklama / Oturum</td>
                                </tr>
                                <tr>
                                    @foreach (var day in new[] { "Pazartesi", "Salı", "Çarşamba", "Perşembe", "Cuma", "Cumartesi", "Pazar" })
                                    {
                                        <td>
                                            <select class="form-select form-select-sm schedule-dropdown" data-day="@day" data-oturum="@row" style="font-size: 12px; border-radius: 6px;">
                                                <option value="">Seçiniz...</option>
                                            </select>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-primary px-4 fw-bold" onclick="saveSchedule()"><i class="bi bi-save"></i> Programı Kaydet</button>
            </div>
        </div>
    </div>
</div>

<!-- Excel Toplu Program Yükleme Modal -->
<div class="modal fade" id="excelUploadModal" tabindex="-1" aria-labelledby="excelUploadModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold" id="excelUploadModalLabel"><i class="bi bi-file-earmark-excel-fill me-1"></i> Excel'den Toplu Program Yükle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UploadExcel" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">Tüm öğretmenlerin ders programlarını Excel kullanarak tek seferde toplu yükleyebilirsiniz. Lütfen aşağıdaki şablona uygun bir dosya yükleyin.</p>
                    
                    <div class="mb-4 text-center bg-light p-3 rounded-3 border">
                        <a asp-action="DownloadTemplate" class="btn btn-sm btn-outline-success fw-bold">
                            <i class="bi bi-download me-1"></i> Excel Şablonunu İndir
                        </a>
                        <div class="text-muted small mt-2">Şablon formatı: KullaniciAdi | Gun | OturumNo | Salon</div>
                    </div>

                    <div class="mb-3">
                        <label for="excelFile" class="form-label fw-bold">Dosya Seçin</label>
                        <input type="file" name="excelFile" id="excelFile" class="form-control" accept=".xlsx" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Kapat</button>
                    <button type="submit" class="btn btn-success fw-bold"><i class="bi bi-upload"></i> Yüklemeyi Başlat</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    let activeRoomsList = [];

    function openScheduleModal(proctorId, proctorName) {
        document.getElementById("modalProctorId").value = proctorId;
        document.getElementById("scheduleModalLabel").innerText = proctorName + " - Haftalık Ders Programı";
        
        // Reset all selects
        const selects = document.querySelectorAll(".schedule-dropdown");
        selects.forEach(sel => {
            sel.innerHTML = '<option value="">Seçiniz...</option>';
        });

        // Fetch data
        fetch(`/GunlukYoklamaci/GetProgram/${proctorId}`)
            .then(res => res.json())
            .then(data => {
                activeRoomsList = data.salons || [];
                
                // Populate salons dropdown
                selects.forEach(sel => {
                    activeRoomsList.forEach(r => {
                        const opt = document.createElement("option");
                        opt.value = r;
                        opt.textContent = r;
                        sel.appendChild(opt);
                    });
                });

                // Pre-select program values
                if (data.program) {
                    data.program.forEach(p => {
                        const selectEl = document.querySelector(`.schedule-dropdown[data-day="${p.gun}"][data-oturum="${p.oturumNo}"]`);
                        if (selectEl) {
                            selectEl.value = p.salon;
                        }
                    });
                }

                // Show modal
                const myModal = new bootstrap.Modal(document.getElementById('scheduleModal'));
                myModal.show();
            })
            .catch(err => {
                alert("Ders programı yüklenirken bir hata oluştu.");
                console.error(err);
            });
    }

    function saveSchedule() {
        const proctorId = document.getElementById("modalProctorId").value;
        const selects = document.querySelectorAll(".schedule-dropdown");
        const items = [];

        selects.forEach(sel => {
            const val = sel.value;
            if (val) {
                items.push({
                    gun: sel.getAttribute("data-day"),
                    oturumNo: parseInt(sel.getAttribute("data-oturum"), 10),
                    salon: val
                });
            }
        });

        fetch(`/GunlukYoklamaci/SaveProgram?proctorId=${proctorId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
            },
            body: JSON.stringify(items)
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                // Close modal
                const modalEl = document.getElementById('scheduleModal');
                const modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
                
                // Refresh list or show success alert
                location.reload();
            } else {
                alert("Program kaydedilemedi.");
            }
        })
        .catch(err => {
            alert("Kaydederken hata oluştu.");
            console.error(err);
        });
    }
</script>

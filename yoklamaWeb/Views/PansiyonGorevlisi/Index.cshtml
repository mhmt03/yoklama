@model yoklamaWeb.ViewModels.Pansiyon.PansiyonGorevlisiListViewModel
@{
    ViewData["Title"] = "Pansiyon Görevlileri";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Pansiyon Görevli Yönetimi</h2>
        <div>
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Yeni Görevli Ekle</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4 shadow-sm border-0 bg-light">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Arama</label>
                    <input type="text" name="Arama" value="@Model.Filter.Arama" class="form-control" placeholder="Ad, kullanıcı adı, telefon, e-posta..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Rol</label>
                    <select name="Rol" asp-items="ViewBag.Roller" class="form-select">
                        <option value="">-- Tüm Roller --</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input type="checkbox" name="SadeceAktif" value="true" class="form-check-input" id="sadeceAktif" @(Model.Filter.SadeceAktif ? "checked" : "") />
                        <label class="form-check-label fw-semibold" for="sadeceAktif">Sadece Aktif Görevliler</label>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-secondary w-100">Filtrele</button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th class="ps-3">Kullanıcı Adı</th>
                    <th>Ad Soyad</th>
                    <th>Rol</th>
                    <th>Telefon</th>
                    <th>E-posta</th>
                    <th>Durum</th>
                    <th>Kayıt Tarihi</th>
                    <th class="text-end pe-3">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Gorevlisiler.Any())
                {
                    @foreach (var g in Model.Gorevlisiler)
                    {
                        <tr>
                            <td class="ps-3">@g.KullaniciAdi</td>
                            <td><strong>@g.AdSoyad</strong></td>
                            <td>
                                <span class="badge bg-secondary p-2">@g.Rol</span>
                            </td>
                            <td>@(g.Telefon ?? "-")</td>
                            <td>@(g.Email ?? "-")</td>
                            <td>
                                @if (g.Aktif)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td>@g.KayitTarihi.ToString("dd.MM.yyyy")</td>
                            <td class="text-end pe-3">
                                <a asp-action="Details" asp-route-id="@g.Id" class="btn btn-sm btn-info me-1"><i class="bi bi-eye"></i> Detay</a>
                                <a asp-action="Edit" asp-route-id="@g.Id" class="btn btn-sm btn-warning me-1"><i class="bi bi-pencil"></i> Düzenle</a>
                                <a asp-action="Delete" asp-route-id="@g.Id" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Sil</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">Görevli kaydı bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

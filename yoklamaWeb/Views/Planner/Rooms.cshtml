@model IEnumerable<yoklamaWeb.Models.PlannerRoom>
@{
    ViewData["Title"] = "Sınav Salonları";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 style="font-family: 'Outfit', sans-serif; color: #2c3e50;">Sınav Salonları</h2>
            <p class="text-muted">Oturma planlamasında kullanılacak sınav salonları ve kapasiteleri.</p>
        </div>
        <a asp-action="CreateRoom" class="btn btn-success">Yeni Salon Ekle</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">Henüz eklenmiş sınav salonu bulunamadı.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Salon Adı</th>
                                <th>Grup</th>
                                <th>Kapasite (Kişi)</th>
                                <th style="width: 150px;">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.RoomName</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.RoomGroup))
                                        {
                                            <span class="badge bg-primary">@item.RoomGroup</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary text-white-50">Belirtilmemiş</span>
                                        }
                                    </td>
                                    <td>@item.Capacity</td>
                                    <td>
                                        <a asp-action="EditRoom" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                        <form asp-action="DeleteRoom" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu salonu silmek istediğinizden emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@model IEnumerable<yoklamaWeb.Models.PlannerExam>
@{
    ViewData["Title"] = "Planlama Sınavları";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 style="font-family: 'Outfit', sans-serif; color: #2c3e50;">Planlama Sınavları</h2>
            <p class="text-muted">Rastgele yerleşim oturma planı yapılacak sınavlar.</p>
        </div>
        <a asp-action="CreateExam" class="btn btn-success">Yeni Sınav Oluştur</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-info mb-0">Henüz planlama sınavı oluşturulmadı.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Sınav Adı</th>
                                <th>Sınav Tarihi</th>
                                <th>Başlangıç Saati</th>
                                <th style="">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">@item.Name</td>
                                    <td>@item.ExamDate.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("tr-TR"))</td>
                                    <td>@item.StartTime</td>
                                    <td>
                                        <a asp-action="ConfigureExam" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Yerleşim Ayarları</a>
                                        <a asp-action="SeatingDetails" asp-route-id="@item.Id" class="btn btn-sm btn-info">Oturma Planı</a>
                                        <a asp-action="EditExam" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                        <form asp-action="DeleteExam" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu sınavı ve tüm oturma planını silmek istediğinizden emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

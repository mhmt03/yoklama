@model yoklamaWeb.Models.Etut
@{
    ViewData["Title"] = "Etüt Salonunu Sil";
    Layout = "_Layout";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0 border-danger">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Etüt Salonunu Sil</h4>
        </div>
        <div class="card-body p-4 text-center">
            <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
            <h5 class="mt-3">Bu etüt salonunu silmek istediğinizden emin misiniz?</h5>
            
            <div class="alert alert-warning text-start mt-3">
                <strong>@Model.EtutAdi</strong> salonu silinecektir.<br />
                Kapasite: @Model.Kapasite <br />
                Kayıtlı Öğrenci Sayısı: @Model.Ogrenciler.Count <br />
                <span class="text-danger small fw-bold">* Bu etüt salonuna atanmış olan öğrencilerin etüt bilgisi sıfırlanacaktır.</span>
            </div>

            <form method="post" asp-action="Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
                    <button type="submit" class="btn btn-danger">Evet, Sil</button>
                </div>
            </form>
        </div>
    </div>
</div>

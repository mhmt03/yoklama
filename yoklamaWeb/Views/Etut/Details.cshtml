@model yoklamaWeb.Models.Etut
@{
    ViewData["Title"] = "Etüt Salonu Detayları";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Etüt Bilgileri</h5>
                </div>
                <div class="card-body">
                    <h4 class="text-primary fw-bold">@Model.EtutAdi</h4>
                    <hr />
                    <p><strong>Kapasite:</strong> @Model.Kapasite Kişi</p>
                    <p><strong>Doluluk:</strong> @Model.Ogrenciler.Count / @Model.Kapasite</p>
                    <p><strong>Açıklama:</strong> @(string.IsNullOrWhiteSpace(Model.Aciklama) ? "-" : Model.Aciklama)</p>
                    <p>
                        <strong>Durum:</strong> 
                        @if (Model.Aktif)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Pasif</span>
                        }
                    </p>
                    <p><strong>Oluşturma Tarihi:</strong> @Model.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</p>
                    <hr />
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-white">Düzenle</a>
                        <a asp-action="Index" class="btn btn-secondary">Etüt Listesine Dön</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Bu Etütte Kayıtlı Öğrenciler</h5>
                    <span class="badge bg-white text-primary">Toplam: @Model.Ogrenciler.Count</span>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show text-start" role="alert">
                            <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show text-start" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Öğrenci Ekleme Paneli -->
                    <div class="card bg-light border-0 mb-4 text-start">
                        <div class="card-header bg-secondary text-white py-2">
                            <h6 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-1"></i> Etüte Çoklu Öğrenci Ekle</h6>
                        </div>
                        <div class="card-body p-3">
                            @if (!((IEnumerable<yoklamaWeb.Models.PansiyonOgrenci>)ViewBag.AvailableStudents).Any())
                            {
                                <div class="text-muted small">Etüte eklenebilecek uygun öğrenci bulunamadı.</div>
                            }
                            else
                            {
                                <form asp-action="AddStudents" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="etutId" value="@Model.Id" />
                                    
                                    <div class="d-flex gap-2 mb-2">
                                        <input type="text" id="availableStudentSearch" class="form-control form-control-sm" placeholder="Listede öğrenci ara..." />
                                        <div class="form-check d-flex align-items-center mb-0 ms-2">
                                            <input type="checkbox" id="selectAllAvailable" class="form-check-input" />
                                            <label class="form-check-label small fw-bold ms-1" for="selectAllAvailable">Tümünü Seç</label>
                                        </div>
                                    </div>

                                    <div class="border rounded p-2 bg-white mb-3" style="max-height: 200px; overflow-y: auto;">
                                        <div class="row row-cols-1 row-cols-md-2 g-2" id="availableStudentsList">
                                            @foreach (var s in (IEnumerable<yoklamaWeb.Models.PansiyonOgrenci>)ViewBag.AvailableStudents)
                                            {
                                                <div class="col student-checkbox-item">
                                                    <div class="form-check">
                                                        <input type="checkbox" name="ogrenciIds" value="@s.Id" class="form-check-input available-student-chk" id="student_chk_@s.Id" />
                                                        <label class="form-check-label small" for="student_chk_@s.Id">
                                                            <strong>@s.OgrenciNo</strong> - @s.AdSoyad <span class="text-muted small">(@s.SinifDuzeyi-@s.Sube)</span>
                                                            @if (s.Etut != null)
                                                            {
                                                                <span class="badge bg-warning text-dark ms-1 small">Mevcut: @s.Etut.EtutAdi</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-secondary ms-1 small">etüte kayıtlı değil</span>
                                                            }
                                                        </label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="small text-muted" id="selectedCountText">Seçilen: 0 öğrenci</span>
                                        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-person-check-fill me-1"></i> Seçilenleri Etüte Ekle</button>
                                    </div>
                                </form>
                            }
                        </div>
                    </div>

                    @if (!Model.Ogrenciler.Any())
                    {
                        <div class="alert alert-info mb-0">Bu etüt salonunda kayıtlı öğrenci bulunmamaktadır.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle text-start">
                                <thead>
                                    <tr>
                                        <th>Öğrenci No</th>
                                        <th>Ad Soyad</th>
                                        <th>Sınıf / Şube</th>
                                        <th>Telefon</th>
                                        <th>Durum</th>
                                        <th>İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var student in Model.Ogrenciler.OrderBy(s => s.AdSoyad))
                                    {
                                        <tr>
                                            <td>@student.OgrenciNo</td>
                                            <td class="fw-bold">@student.AdSoyad</td>
                                            <td>@student.SinifDuzeyi-@student.Sube</td>
                                            <td>@student.Telefon</td>
                                            <td>
                                                @if (student.Aktif)
                                                {
                                                    <span class="badge bg-success">Aktif</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Pasif</span>
                                                }
                                            </td>
                                            <td>
                                                <form asp-action="RemoveStudent" method="post" class="d-inline" onsubmit="return confirm('Bu öğrenciyi etüt salonundan kaldırmak istediğinize emin misiniz?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="etutId" value="@Model.Id" />
                                                    <input type="hidden" name="ogrenciId" value="@student.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-person-dash"></i> Kaldır</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Client-side search and selection for available students in study hall addition
            const searchInput = document.getElementById('availableStudentSearch');
            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    const filterVal = this.value.trim().toLowerCase();
                    const items = document.querySelectorAll('.student-checkbox-item');
                    items.forEach(item => {
                        const labelText = item.querySelector('label').innerText.toLowerCase();
                        item.style.display = labelText.includes(filterVal) ? '' : 'none';
                    });
                });
            }

            const selectAllChk = document.getElementById('selectAllAvailable');
            if (selectAllChk) {
                selectAllChk.addEventListener('change', function() {
                    const isChecked = this.checked;
                    const checkboxes = document.querySelectorAll('.available-student-chk');
                    checkboxes.forEach(chk => {
                        const parent = chk.closest('.student-checkbox-item');
                        if (parent && parent.style.display !== 'none') {
                            chk.checked = isChecked;
                        }
                    });
                    updateSelectedCount();
                });
            }

            function updateSelectedCount() {
                const selected = document.querySelectorAll('.available-student-chk:checked').length;
                const txt = document.getElementById('selectedCountText');
                if (txt) {
                    txt.innerText = `Seçilen: ${selected} öğrenci`;
                }
            }

            document.addEventListener('change', function(e) {
                if (e.target.classList.contains('available-student-chk')) {
                    updateSelectedCount();
                }
            });
        });
    </script>
}

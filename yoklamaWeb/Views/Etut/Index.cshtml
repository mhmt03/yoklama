@model IEnumerable<yoklamaWeb.Models.Etut>
@{
    ViewData["Title"] = "Etüt Salonları Yönetimi";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h2 style="font-family: 'Outfit', sans-serif; color: #2c3e50;">Etüt Salonları Yönetimi</h2>
            <p class="text-muted mb-0">Pansiyon etüt salonlarını ve kapasitelerini buradan yönetebilirsiniz.</p>
        </div>
        <div class="mt-2 mt-md-0">
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Yeni Etüt Salonu Ekle</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body">
            <form method="get" class="row g-2">
                <div class="col-md-6">
                    <input type="text" name="arama" class="form-control" placeholder="Etüt salonu adı veya açıklama ara..." value="@ViewBag.Arama" />
                </div>
                <div class="col-md-4 d-flex align-items-center">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="sadeceAktif" id="sadeceAktifCheck" value="true" @(ViewBag.SadeceAktif ? "checked" : "") onchange="this.form.submit()" />
                        <label class="form-check-label fw-bold" for="sadeceAktifCheck">
                            Sadece Aktif Salonları Göster
                        </label>
                    </div>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-dark">Filtrele / Ara</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Etüt Salonu</th>
                            <th>Kapasite</th>
                            <th>Kayıtlı Öğrenci</th>
                            <th>Doluluk Oranı</th>
                            <th>Durum</th>
                            <th style="width: 200px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Kayıtlı etüt salonu bulunamadı.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                var studentCount = item.Ogrenciler?.Count ?? 0;
                                double fillPercent = item.Kapasite > 0 ? ((double)studentCount / item.Kapasite) * 100 : 0;
                                string progressColor = fillPercent >= 100 ? "bg-danger" : fillPercent >= 80 ? "bg-warning" : "bg-success";

                                <tr>
                                    <td class="fw-bold text-primary">@item.EtutAdi</td>
                                    <td>@item.Kapasite Kişi</td>
                                    <td>@studentCount Kişi</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 10px;">
                                                <div class="progress-bar @progressColor" role="progressbar" style="width: @(fillPercent > 100 ? 100 : fillPercent)%" aria-valuenow="@studentCount" aria-valuemin="0" aria-valuemax="@item.Kapasite"></div>
                                            </div>
                                            <span class="small fw-semibold">@fillPercent.ToString("0")%</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.Aktif)
                                        {
                                            <span class="badge bg-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Pasif</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Detay</a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Düzenle</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@model yoklamaWeb.Models.Etut
@{
    ViewData["Title"] = "Yeni Etüt Salonu Ekle";
    Layout = "_Layout";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Yeni Etüt Salonu Ekle</h4>
        </div>
        <div class="card-body p-4">
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="EtutAdi" class="form-label fw-bold"></label>
                    <input asp-for="EtutAdi" class="form-control" placeholder="Örn: 9. Sınıf Etüt Salonu" required />
                    <span asp-validation-for="EtutAdi" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Kapasite" class="form-label fw-bold"></label>
                    <input asp-for="Kapasite" type="number" class="form-control" min="1" max="1000" required />
                    <span asp-validation-for="Kapasite" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Aciklama" class="form-label fw-bold"></label>
                    <textarea asp-for="Aciklama" class="form-control" rows="3" placeholder="Etüt salonu ile ilgili açıklama..."></textarea>
                    <span asp-validation-for="Aciklama" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="Aktif" type="checkbox" class="form-check-input" id="Aktif" checked />
                    <label class="form-check-label fw-semibold" for="Aktif">Etüt Salonu Aktif</label>
                    <span asp-validation-for="Aktif" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

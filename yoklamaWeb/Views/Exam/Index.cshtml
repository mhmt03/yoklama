@model IEnumerable<yoklamaWeb.Models.Exam>

@{
    ViewData["Title"] = "Sınav Listesi";
    Layout = "_Layout";
}
<link href="~/css/site.css" rel="stylesheet" />
<div class="d-flex flex-column flex-md-row align-items-center justify-content-between mt-4 mb-3 gap-3">
    <div>
        <h2 class="mb-1" style="font-family: 'Outfit', sans-serif; color: #2c3e50;">Sınav Listesi</h2>
        <p class="text-muted mb-0">Sınavları hızlıca görüntüleyin, düzenleyin veya koltuk atamalarına geçin.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg">Yeni Sınav Oluştur</a>
</div>

<div class="card mb-4 p-3 border-0 shadow-sm">
    <form method="get" class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Sınav Adı</label>
            <input name="nameFilter" value="@ViewData["NameFilter"]" class="form-control" placeholder="Ara..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">Bina</label>
            <input name="buildingFilter" value="@ViewData["BuildingFilter"]" class="form-control" placeholder="Bina..." />
        </div>
        <div class="col-md-3">
            <label class="form-label">Durum</label>
            <select name="statusFilter" class="form-select">
                @{ var statusFilter = ViewData["StatusFilter"]?.ToString(); }
                @if (statusFilter == "All")
                {
                    <option value="All" selected> Tümü</option>
                }
                else
                {
                    <option value="All">Tümü</option>
                }
                @if (statusFilter == "Active")
                {
                    <option value="Active" selected>Aktif</option>
                }
                else
                {
                    <option value="Active">Aktif</option>
                }
                @if (statusFilter == "Expired")
                {
                    <option value="Expired" selected>Süresi Dolmuş</option>
                }
                else
                {
                    <option value="Expired">Süresi Dolmuş</option>
                }
                @if (statusFilter == "Upcoming")
                {
                    <option value="Upcoming" selected>Gelecek</option>
                }
                else
                {
                    <option value="Upcoming">Gelecek</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-outline-primary w-100">Filtrele</button>
        </div>
    </form>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    @foreach (var exam in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="card-title mb-1" style="color: #2c3e50;">@exam.Name</h5>
                            <span class="badge bg-secondary">@exam.ApplicationDate.ToString("yyyy-MM-dd")</span>
                        </div>
                        <span class="badge bg-warning text-dark">Bina @exam.BuildingNumber</span>
                    </div>
                    <p class="card-text text-muted mb-2"><strong>Geçerlilik:</strong> @exam.ValidFrom.ToString("yyyy-MM-dd") - @exam.ValidTo.ToString("yyyy-MM-dd")</p>
                    <p class="card-text text-muted mb-3"><strong>Saat:</strong> @(exam.StartTime.HasValue ? exam.StartTime.Value.ToString(@"hh\:mm") : "N/A") - @(exam.EndTime.HasValue ? exam.EndTime.Value.ToString(@"hh\:mm") : "N/A")</p>
                    <div class="mt-auto d-flex flex-wrap gap-2">
                        <a asp-action="Edit" asp-route-id="@exam.Id" class="btn btn-outline-primary btn-sm">Düzenle</a>
                        <a asp-action="Details" asp-route-id="@exam.Id" class="btn btn-primary btn-sm">Detay</a>
                        <a asp-action="ImportSeats" asp-route-id="@exam.Id" class="btn btn-success btn-sm">Koltuk İçe Aktar</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

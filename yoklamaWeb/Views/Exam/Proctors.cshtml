@model IEnumerable<yoklamaWeb.Models.TemporaryProctor>

@{
    ViewData["Title"] = "Yoklamacı Listesi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Yoklamacı Listesi</h2>
            <p class="text-muted mb-0">@ViewBag.ExamName sınavı için oluşturulmuş salon bazlı yoklamacılar.</p>
        </div>
        <div>
            <a asp-action="CreateProctor" asp-route-examId="@ViewBag.ExamId" class="btn btn-success me-1">Yeni Yoklamacı Ekle</a>
            <a asp-action="Details" asp-route-id="@ViewBag.ExamId" class="btn btn-secondary">Geri</a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Bu sınav için henüz yoklamacı oluşturulmamış.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Salon</th>
                        <th>Kullanıcı Adı</th>
                        <th>Şifre</th>
                        <th>Geçerlilik</th>
                        <th>Saat Aralığı</th>
                        <th style="width: 150px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Room</td>
                            <td>@item.User?.UserName</td>
                            <td>@item.Password</td>
                            <td>@item.ValidFrom.ToString("yyyy-MM-dd") - @item.ValidTo.ToString("yyyy-MM-dd")</td>
                            <td>@(item.StartTime.HasValue ? item.StartTime.Value.ToString(@"hh\:mm") : "-") - @(item.EndTime.HasValue ? item.EndTime.Value.ToString(@"hh\:mm") : "-")</td>
                            <td>
                                <a asp-action="EditProctor" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                <form asp-action="DeleteProctor" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bu yoklamacıyı silmek istediğinizden emin misiniz?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

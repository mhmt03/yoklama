            align-items: center;
        }
.save-btn{
    padding: 0;
    font-size: 12px;
    display: flex;
    justify-content: center;
    align-items: center;
    
    max-width: 80px;
    height: auto;
}
.room-note-input{
    
    height: 20px;
    font-size: 12px;
}
.note-input{
    
    height: 20px;
    font-size: 12px;
}


        .compact-filters .compact-filter {
            min-width: 100%;
        }

        .table td,
        .table th {
            white-space: normal;
        }

        .compact-delete-btn {
            min-width: 1.7rem;
        }

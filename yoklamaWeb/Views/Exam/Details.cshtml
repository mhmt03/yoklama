</style>

<script>
    (function() {
        const searchInput = document.getElementById('seatSearch');
        const salonFilter = document.getElementById('salonFilter');
        const subeFilter = document.getElementById('subeFilter');
        const items = Array.from(document.querySelectorAll('.seat-row, .seat-card'));

        function toggleNoteHeight(item) {
            const noteFields = item.querySelectorAll('textarea[name="note"], textarea[name="roomNote"], input[name="proctorName"]');
            const hasNotes = Array.from(noteFields).some(field => (field.value || '').trim().length > 0);
            item.classList.toggle('has-notes', hasNotes);
        }

        function applySeatFilters() {
            const query = (searchInput?.value || '').trim().toLowerCase();
            const salonValue = (salonFilter?.value || '').trim().toLowerCase();
            const subeValue = (subeFilter?.value || '').trim().toLowerCase();

            items.forEach(item => {
                const text = item.textContent.toLowerCase();
                const salonText = (item.getAttribute('data-salon') || '').toLowerCase();
                const subeText = (item.getAttribute('data-sube') || '').toLowerCase();
                const matchesQuery = !query || text.includes(query);
                
                let matchesSalon = true;
                if (salonValue === 'belirsiz') {
                    matchesSalon = !salonText || salonText.trim() === '';
                } else if (salonValue) {
                    matchesSalon = salonText === salonValue;
                }

                let matchesSube = true;
                if (subeValue === 'şube yok') {
                    matchesSube = !subeText || subeText.trim() === '' || subeText === 'şube yok';
                } else if (subeValue) {
                    matchesSube = subeText === subeValue;
                }
                item.style.display = matchesQuery && matchesSalon && matchesSube ? '' : 'none';
            });
        }

        items.forEach(item => {
            toggleNoteHeight(item);
            item.querySelectorAll('textarea[name="note"], textarea[name="roomNote"], input[name="proctorName"]').forEach(field => {
                field.addEventListener('input', () => toggleNoteHeight(item));
            });
        });

        if (searchInput) searchInput.addEventListener('input', applySeatFilters);
        if (salonFilter) salonFilter.addEventListener('change', applySeatFilters);
        if (subeFilter) subeFilter.addEventListener('change', applySeatFilters);

        // Sorting function
        let sortDirections = {};
        window.sortTable = function(columnIndex) {
            const table = document.getElementById("seatTable");
            const tbody = table.querySelector("tbody");
            const rows = Array.from(tbody.querySelectorAll("tr"));
            if (rows.length === 0) return;

            const currentDirection = sortDirections[columnIndex] || 'asc';
            const newDirection = currentDirection === 'asc' ? 'desc' : 'asc';
            sortDirections[columnIndex] = newDirection;

            // Reset icons
            table.querySelectorAll("th .sort-icon").forEach(icon => {
                icon.className = "bi bi-arrow-down-up ms-1 sort-icon small text-muted";
            });

            const activeHeader = table.querySelectorAll("th")[columnIndex];
            const activeIcon = activeHeader.querySelector(".sort-icon");
            if (activeIcon) {
                activeIcon.className = newDirection === 'asc' 
                    ? "bi bi-arrow-up ms-1 text-primary sort-icon small" 
                    : "bi bi-arrow-down ms-1 text-primary sort-icon small";
            }

            rows.sort((rowA, rowB) => {
                let cellA = "";
                let cellB = "";

                if (columnIndex === 0) {
                    cellA = rowA.cells[0].querySelector('.fw-semibold').innerText.trim();
                    cellB = rowB.cells[0].querySelector('.fw-semibold').innerText.trim();
                } else if (columnIndex === 1) {
                    cellA = rowA.cells[1].innerText.trim();
                    cellB = rowB.cells[1].innerText.trim();
                } else if (columnIndex === 2) {
                    const radioA = rowA.querySelector('.status-radio:checked');
                    const radioB = rowB.querySelector('.status-radio:checked');
                    cellA = radioA ? radioA.value : "";
                    cellB = radioB ? radioB.value : "";
                } else if (columnIndex === 3 || columnIndex === 4) {
                    cellA = rowA.cells[columnIndex].querySelector('textarea').value.trim();
                    cellB = rowB.cells[columnIndex].querySelector('textarea').value.trim();
                } else if (columnIndex === 5) {
                    cellA = rowA.cells[5].querySelector('input').value.trim();
                    cellB = rowB.cells[5].querySelector('input').value.trim();
                }

                if (columnIndex === 2) {
                    const numA = parseInt(cellA) || 0;
                    const numB = parseInt(cellB) || 0;
                    return newDirection === 'asc' ? numA - numB : numB - numA;
                } else {
                    return newDirection === 'asc' 
                        ? cellA.localeCompare(cellB, 'tr') 
                        : cellB.localeCompare(cellA, 'tr');
                }
            });

            rows.forEach(row => tbody.appendChild(row));
        };

        const editModal = document.getElementById('seatEditModal');
        if (editModal) {
            editModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                document.getElementById('editSeatId').value = button.getAttribute('data-seat-id');
                document.getElementById('editSeatNumber').value = button.getAttribute('data-seat-number');
                document.getElementById('editSalon').value = button.getAttribute('data-salon');
                document.getElementById('editSira').value = button.getAttribute('data-sira');
                document.getElementById('editBina').value = button.getAttribute('data-bina');
            });
        }

        document.querySelectorAll('.seat-row').forEach(row => {
            row.addEventListener('click', event => {
                const interactive = event.target.closest('a, button, input, textarea, select, label, form');
                if (interactive) return;
                const button = row.querySelector('[data-bs-toggle="modal"][data-bs-target="#seatEditModal"]');
                if (button) {
                    button.click();
                }
            });
        });

        // Dynamic save logic
        function saveSeat(element) {
            const container = element.closest('.seat-row, .seat-card');
            const seatId = container.getAttribute('data-seat-id');
            const checkedRadio = container.querySelector('.status-radio:checked');
            const attendanceStatus = checkedRadio ? checkedRadio.value : 0;
            const note = container.querySelector('.note-input').value;
            const roomNote = container.querySelector('.room-note-input').value;
            const proctorName = container.querySelector('.proctor-input').value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            container.style.opacity = '0.6';

            const formData = new FormData();
            formData.append('seatId', seatId);
            formData.append('attendanceStatus', attendanceStatus);
            formData.append('note', note);
            formData.append('roomNote', roomNote);
            formData.append('proctorName', proctorName);
            formData.append('__RequestVerificationToken', token);

            fetch('/Exam/UpdateSeat', {
                method: 'POST',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData
            })
            .then(r => r.json())
            .then(data => {
                container.style.opacity = '1';
                
                // Update CSS classes
                const statusClass = getStatusClass(parseInt(attendanceStatus));
                
                // Check if row or card
                if (container.classList.contains('seat-row')) {
                    container.className = `seat-row ${statusClass}`;
                } else {
                    container.className = `seat-card ${statusClass} mb-2`;
                }
                
                // Also update the mobile badge text if it exists
                const badge = container.querySelector('.status-badge');
                if (badge) {
                    badge.textContent = getStatusLabel(parseInt(attendanceStatus));
                }
            })
            .catch(err => {
                container.style.opacity = '1';
                console.error(err);
            });
        }

        function getStatusClass(status) {
            switch(status) {
                case 1: return 'status-present';
                case 2: return 'status-absent';
                case 3: return 'status-late';
                default: return 'status-pending';
            }
        }

        function getStatusLabel(status) {
            switch(status) {
                case 1: return 'Var';
                case 2: return 'Yok';
                case 3: return 'Geç';
                default: return 'Belirsiz';
            }
        }

        window.markAllVisible = function(statusValue) {
            const items = document.querySelectorAll('.seat-row, .seat-card');
            items.forEach(item => {
                if (item.style.display !== "none") {
                    const radios = item.querySelectorAll('.status-radio');
                    radios.forEach(radio => {
                        if (parseInt(radio.value) === statusValue && !radio.checked) {
                            radio.checked = true;
                            radio.dispatchEvent(new Event('change', { bubbles: true }));
                        }
                    });
                }
            });
        };

        // Event listeners for dynamic autosave
        document.addEventListener('change', function(e) {
            if (e.target.matches('.status-radio')) {
                saveSeat(e.target);
            }
        });

        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.save-btn');
            if (btn) {
                saveSeat(btn);
            }
        });
    })();
</script>

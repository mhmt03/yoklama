@model yoklamaWeb.Models.AdminExamDetailsViewModel

@{
    ViewData["Title"] = "Sınav Detayları";
    Layout = "_Layout";
    var statusValues = Enum.GetValues<AttendanceStatus>();
    var uniqueSalons = Model.Seats
        .Where(s => !string.IsNullOrWhiteSpace(s.SalonAdi))
        .Select(s => s.SalonAdi.Trim())
        .Distinct()
        .OrderBy(s => s)
        .ToList();
    var uniqueSubeler = Model.Seats
        .Where(s => !string.IsNullOrWhiteSpace(s.Sube))
        .Select(s => s.Sube.Trim())
        .Distinct()
        .OrderBy(s => s)
        .ToList();
}

@functions{
    string StatusLabel(AttendanceStatus status) => status switch
    {
        AttendanceStatus.Katildi => "Var",
        AttendanceStatus.Katilmadi => "Yok",
        AttendanceStatus.Gec => "Geç",
        _ => "Belirsiz"
    };

    string StatusClass(AttendanceStatus status) => status switch
    {
        AttendanceStatus.Katildi => "status-present",
        AttendanceStatus.Katilmadi => "status-absent",
        AttendanceStatus.Gec => "status-late",
        _ => "status-pending"
    };
}

<div class="container py-2 exam-shell">
    @Html.AntiForgeryToken()
    <div class="card shadow-sm border-0 mb-3 exam-header-card">
        <div class="card-body py-3 px-3 px-lg-4">
            <div class="d-flex flex-column flex-lg-row justify-content-between gap-2">
                <div>
                    <h1 class="h5 mb-1">@Model.ExamName</h1>
                    <p class="text-muted small mb-0">@Model.ApplicationDate.ToString("dd.MM.yyyy") • Bina @Model.BuildingNumber</p>
                </div>
                <div class="d-flex flex-wrap gap-1 compact-actions align-items-center">
                    <a asp-action="Details" asp-route-id="@Model.ExamId" class="btn btn-sm btn-outline-secondary compact-action-btn">Yenile</a>
                    <button type="button" class="btn btn-sm btn-success compact-action-btn" data-bs-toggle="modal" data-bs-target="#exportExcelModal">Excel'e Aktar</button>
                    <a asp-action="Edit" asp-route-id="@Model.ExamId" class="btn btn-sm btn-outline-primary compact-action-btn">Düzenle</a>
                    <a asp-action="ImportSeats" asp-route-id="@Model.ExamId" class="btn btn-sm btn-success compact-action-btn">İçe Aktar</a>
                    <form asp-action="GenerateProctors" asp-route-id="@Model.ExamId" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-warning compact-action-btn">Yoklamacı listesi</button>
                    </form>
                    <button type="button" class="btn btn-sm btn-primary compact-action-btn" data-bs-toggle="modal" data-bs-target="#addStudentModal">Öğrenci Ekle</button>
                </div>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-md-6 col-lg-3">
                    <div class="p-2 rounded-3 bg-light compact-stat-card">
                        <div class="text-muted small">Yoklama Oturumu</div>
                        <select class="form-select form-select-sm fw-bold border-primary" onchange="location.href='?yoklamaNo=' + this.value;">
                            @for (int i = 1; i <= Model.YoklamaSayisi; i++)
                            {
                                <option value="@i" selected="@(i == Model.SelectedYoklamaNo)">Yoklama @i</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-6 col-lg-2">
                    <div class="p-2 rounded-3 bg-light compact-stat-card">
                        <div class="text-muted small">Geçerlilik</div>
                        <div class="fw-semibold small">@Model.ValidFrom.ToString("dd.MM.yyyy") – @Model.ValidTo.ToString("dd.MM.yyyy")</div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-2">
                    <div class="p-2 rounded-3 bg-light compact-stat-card">
                        <div class="text-muted small">Saat</div>
                        <div class="fw-semibold small">@(Model.StartTime.HasValue ? Model.StartTime.Value.ToString("hh\\:mm") : "—") – @(Model.EndTime.HasValue ? Model.EndTime.Value.ToString("hh\\:mm") : "—")</div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-2">
                    <div class="p-2 rounded-3 bg-light compact-stat-card">
                        <div class="text-muted small">Toplam</div>
                        <div class="fw-semibold small">@Model.TotalStudents öğrenci</div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="p-2 rounded-3 bg-light compact-stat-card">
                        <div class="text-muted small">Yoklama @Model.SelectedYoklamaNo Durumlar</div>
                        <div class="fw-semibold small">Var @Model.PresentCount • Yok @Model.AbsentCount • Geç @Model.LateCount • Beklemede @Model.PendingCount</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="d-flex flex-column flex-md-row justify-content-between gap-2 mb-2">
                <div>
                    <h2 class="h6 mb-1">Koltuk Atamaları</h2>
                    <select id="salonFilter" class="form-select form-select-sm compact-filter">
                        <option value="">Tüm Salonlar</option>
                        <option value="belirsiz">Belirsiz (Atanmamış)</option>
                        @foreach (var salon in uniqueSalons)
                        {
                            <option value="@salon">@salon</option>
                        }
                    </select>
                </div>
                <div>

                    <select id="subeFilter" class="form-select form-select-sm compact-filter">
                        <option value="">Tüm Şubeler</option>
                        <option value="şube yok">Şube Yok</option>
                        @foreach (var sube in uniqueSubeler)
                        {
                            <option value="@sube">@sube</option>
                        }
                    </select>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2 compact-filters">
                    <input id="seatSearch" type="text" class="form-control form-control-sm compact-filter" placeholder="Öğrenci ara" />
                    
                    
                </div>
            </div>

            <!-- Bulk Actions for Visible/Filtered Students -->
            <div class="d-flex gap-2 mb-3 align-items-center bg-light p-2 rounded-3 border flex-wrap">
                <span class="text-secondary small fw-bold"><i class="bi bi-check-all"></i> Toplu Yoklama İşlemleri (Filtrelenmiş):</span>
                <button type="button" class="btn btn-sm btn-success px-3 fw-bold" onclick="markAllVisible(1)">Tümü Var</button>
                <button type="button" class="btn btn-sm btn-danger px-3 fw-bold" onclick="markAllVisible(2)">Tümü Yok</button>
                <button type="button" class="btn btn-sm btn-secondary px-3 fw-bold" onclick="markAllVisible(0)">Tümü Belirsiz</button>
            </div>

            @if (Model.Seats.Any())
            {
                <div class="table-responsive d-none d-lg-block">
                    <table id="seatTable" class="table align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                            <th>Sıra</th>
                                <th onclick="sortTable(0)" style="cursor:pointer;">Öğrenci <i class="bi bi-arrow-down-up ms-1 sort-icon small text-muted"></i></th>
                                <th onclick="sortTable(1)" style="cursor:pointer;">Koltuk / Salon <i class="bi bi-arrow-down-up ms-1 sort-icon small text-muted"></i></th>
                                <th onclick="sortTable(2)" style="cursor:pointer;">Durum <i class="bi bi-arrow-down-up ms-1 sort-icon small text-muted"></i></th>
                                <th onclick="sortTable(3)" style="cursor:pointer;">Yoklama Notu <i class="bi bi-arrow-down-up ms-1 sort-icon small text-muted"></i></th>
                                <th onclick="sortTable(4)" style="cursor:pointer;">Salon Notu <i class="bi bi-arrow-down-up ms-1 sort-icon small text-muted"></i></th>
                                <th onclick="sortTable(5)" style="cursor:pointer;">Yoklamacı <i class="bi bi-arrow-down-up ms-1 sort-icon small text-muted"></i></th>
                                <th>İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int sira=1;}
                                @foreach (var row in Model.Seats)
                            
                            {
                                <tr class="seat-row @StatusClass(row.AttendanceStatus)" data-seat-id="@row.SeatId" data-salon="@row.SalonAdi" data-sube="@(string.IsNullOrWhiteSpace(row.Sube) ? "şube yok" : row.Sube.Trim())">
                                   <td>@sira</td>
                                   @{sira++;}
                                    <td>
                                        <div class="fw-semibold">@row.AdSoyad</div>
                                        <div class="small text-muted">@row.OgrenciNo • @row.SinifDuzeyi @row.Sube • Sıra @row.Sira</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-primary">Salon @row.SalonAdi</div>
                                        <div class="small text-muted">Koltuk @row.SeatNumber • Bina @row.BinaNo</div>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Yoklama Durumu">
                                            <input type="radio" class="btn-check status-radio" name="AttendanceStatus-@row.SeatId" id="status-pending-@row.SeatId" value="0" @(row.AttendanceStatus == AttendanceStatus.KontrolEdilmedi ? "checked" : "") />
                                            <label class="btn btn-outline-secondary px-2 fw-bold" for="status-pending-@row.SeatId">Belirsiz</label>

                                            <input type="radio" class="btn-check status-radio" name="AttendanceStatus-@row.SeatId" id="status-present-@row.SeatId" value="1" @(row.AttendanceStatus == AttendanceStatus.Katildi ? "checked" : "") />
                                            <label class="btn btn-outline-success px-2 fw-bold" for="status-present-@row.SeatId">Var</label>

                                            <input type="radio" class="btn-check status-radio" name="AttendanceStatus-@row.SeatId" id="status-absent-@row.SeatId" value="2" @(row.AttendanceStatus == AttendanceStatus.Katilmadi ? "checked" : "") />
                                            <label class="btn btn-outline-danger px-2 fw-bold" for="status-absent-@row.SeatId">Yok</label>

                                            <input type="radio" class="btn-check status-radio" name="AttendanceStatus-@row.SeatId" id="status-late-@row.SeatId" value="3" @(row.AttendanceStatus == AttendanceStatus.Gec ? "checked" : "") />
                                            <label class="btn btn-outline-info px-2 fw-bold" for="status-late-@row.SeatId">Geç</label>
                                        </div>
                                    </td>
                                    <td>
                                        <textarea class="form-control form-control-sm note-input" name="note" rows="2" placeholder="Öğrenci notu">@row.Note</textarea>
                                    </td>
                                    <td>
                                        <textarea class="form-control form-control-sm room-note-input" name="roomNote" rows="2" placeholder="Salon notu">@row.RoomNote</textarea>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1">
                                            <input class="form-control form-control-sm proctor-input" name="proctorName" value="@row.ProctorName" placeholder="Yoklamacı adı" />
                                            <button type="button" class="btn btn-sm btn-outline-primary save-btn" title="Notları ve Yoklamacıyı Kaydet"><i class="bi bi-save"></i></button>
                                        </div>
                                        <div class="small text-muted mt-1">Son güncelleme: @row.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column gap-1 action-cell">
                                            <button type="button" class="btn btn-xs btn-outline-secondary icon-action-btn" data-bs-toggle="modal" data-bs-target="#seatEditModal" data-seat-id="@row.SeatId" data-seat-number="@row.SeatNumber" data-salon="@row.SalonAdi" data-sira="@row.Sira" data-bina="@row.BinaNo" title="Salon/Sıra Düzenle" aria-label="Salon/Sıra Düzenle">
                                                ✎
                                            </button>
                                            <form asp-action="DeleteSeat" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="seatId" value="@row.SeatId" />
                                                <button type="submit" class="btn btn-xs btn-outline-danger icon-action-btn compact-delete-btn" onclick="return confirm('Bu öğrenciyi sınavdan kaldırmak istediğinize emin misiniz?');" title="Sınavdan Kaldır" aria-label="Sınavdan Kaldır">
                                                    🗑
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-block d-lg-none">
                    @foreach (var row in Model.Seats)
                    {
                        <div class="seat-card @StatusClass(row.AttendanceStatus) mb-2" data-salon="@row.SalonAdi" data-sube="@(string.IsNullOrWhiteSpace(row.Sube) ? "şube yok" : row.Sube.Trim())" data-seat-id="@row.SeatId">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <div class="fw-semibold">@row.AdSoyad</div>
                                    <div class="small text-muted">@row.OgrenciNo • @row.SinifDuzeyi @row.Sube • Koltuk @row.SeatNumber</div>
                                </div>
                                <span class="badge rounded-pill bg-light text-dark status-badge">@StatusLabel(row.AttendanceStatus)</span>
                            </div>
                            <div class="small text-muted mt-2">Salon <span class="fw-semibold text-primary">@row.SalonAdi</span> • Sıra @row.Sira • Bina @row.BinaNo</div>
                            <div class="mt-3">
                                <div class="row g-2">
                                    <div class="col-12">
                                        <label class="form-label small">Durum</label>
                                        <div class="btn-group btn-group-sm w-100" role="group" aria-label="Yoklama Durumu">
                                            <input type="radio" class="btn-check status-radio" name="AttendanceStatus-Mobile-@row.SeatId" id="status-pending-mobile-@row.SeatId" value="0" @(row.AttendanceStatus == AttendanceStatus.KontrolEdilmedi ? "checked" : "") />
                                            <label class="btn btn-outline-secondary px-2 fw-bold" for="status-pending-mobile-@row.SeatId">Belirsiz</label>

                                            <input type="radio" class="btn-check status-radio" name="AttendanceStatus-Mobile-@row.SeatId" id="status-present-mobile-@row.SeatId" value="1" @(row.AttendanceStatus == AttendanceStatus.Katildi ? "checked" : "") />
                                            <label class="btn btn-outline-success px-2 fw-bold" for="status-present-mobile-@row.SeatId">Var</label>

                                            <input type="radio" class="btn-check status-radio" name="AttendanceStatus-Mobile-@row.SeatId" id="status-absent-mobile-@row.SeatId" value="2" @(row.AttendanceStatus == AttendanceStatus.Katilmadi ? "checked" : "") />
                                            <label class="btn btn-outline-danger px-2 fw-bold" for="status-absent-mobile-@row.SeatId">Yok</label>

                                            <input type="radio" class="btn-check status-radio" name="AttendanceStatus-Mobile-@row.SeatId" id="status-late-mobile-@row.SeatId" value="3" @(row.AttendanceStatus == AttendanceStatus.Gec ? "checked" : "") />
                                            <label class="btn btn-outline-info px-2 fw-bold" for="status-late-mobile-@row.SeatId">Geç</label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small">Yoklama Notu</label>
                                        <textarea class="form-control form-control-sm note-input" name="note" rows="2">@row.Note</textarea>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small">Salon Notu</label>
                                        <textarea class="form-control form-control-sm room-note-input" name="roomNote" rows="2">@row.RoomNote</textarea>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small">Yoklamacı</label>
                                        <input class="form-control form-control-sm proctor-input" name="proctorName" value="@row.ProctorName" />
                                    </div>
                                </div>
                                <div class="d-flex gap-2 mt-3 butonSatiri">
                                    <button type="button" class="btn btn-sm btn-primary flex-grow-1 save-btn">Kaydet</button>
                                    <button type="button" class="btn btn-xs btn-outline-secondary icon-action-btn" data-bs-toggle="modal" data-bs-target="#seatEditModal" data-seat-id="@row.SeatId" data-seat-number="@row.SeatNumber" data-salon="@row.SalonAdi" data-sira="@row.Sira" data-bina="@row.BinaNo" title="Salon/Sıra Düzenle" aria-label="Salon/Sıra Düzenle">✎</button>
                                 <form asp-action="DeleteSeat" method="post" class="mt-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="seatId" value="@row.SeatId" />
                                <button type="submit" class="btn btn-xs btn-outline-danger icon-action-btn compact-delete-btn" onclick="return confirm('Bu öğrenciyi sınavdan kaldırmak istediğinize emin misiniz?');" title="Sınavdan Kaldır" aria-label="Sınavdan Kaldır">🗑</button>
                            </form>
                                
                                </div>

                            </div>
                           
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Henüz koltuk ataması yapılmadı.</p>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="exportExcelModal" tabindex="-1" aria-labelledby="exportExcelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exportExcelModalLabel">Excel'e Aktar</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <form asp-action="ExportToExcel" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="examId" value="@Model.ExamId" />
                    <div class="mb-3">
                        <label class="form-label" for="sortBy">Sıralama sütunu</label>
                        <select id="sortBy" name="sortBy" class="form-select form-select-sm" required>
                            <option value="OgrenciNo">Öğrenci No</option>
                            <option value="AdSoyad">Adı Soyadı</option>
                            <option value="SinifDuzeyi">Sınıf</option>
                            <option value="Sube">Şube</option>
                            <option value="SalonAdi">Salon</option>
                            <option value="Sira">Sıra</option>
                            <option value="AttendanceStatus">Durum</option>
                            <option value="BinaNo">Bina</option>
                            <option value="Note">Yoklama Notu</option>
                            <option value="RoomNote">Salon Notu</option>
                            <option value="ProctorName">Yoklamacı</option>
                        </select>
                    </div>
                    <div class="text-muted small mb-3">Seçilen sütuna göre veriler sıralanacak ve Excel dosyası oluşturulacaktır.</div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                        <button type="submit" class="btn btn-sm btn-success">Excel'e Aktar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addStudentModal" tabindex="-1" aria-labelledby="addStudentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addStudentModalLabel">Sınava Öğrenci Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <form asp-action="AddStudent" method="post">
                    <input type="hidden" name="examId" value="@Model.ExamId" />
                    <div class="mb-3">
                        <label class="form-label" for="ogrenciNo">Öğrenci No</label>
                        <input class="form-control" id="ogrenciNo" name="ogrenciNo" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="seatNumber">Koltuk No</label>
                        <input class="form-control" id="seatNumber" name="seatNumber" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="salonAdi">Salon</label>
                        <input class="form-control" id="salonAdi" name="salonAdi" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="sira">Sıra</label>
                        <input type="number" class="form-control" id="sira" name="sira" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="binaNo">Bina</label>
                        <input class="form-control" id="binaNo" name="binaNo" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="seatEditModal" tabindex="-1" aria-labelledby="seatEditModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="seatEditModalLabel">Salon / Sıra Düzenle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <form asp-action="UpdateSeatLocation" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editSeatId" name="seatId" />
                    <div class="mb-3">
                        <label class="form-label">Koltuk No</label>
                        <input type="number" class="form-control" id="editSeatNumber" name="seatNumber" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Salon</label>
                        <input class="form-control" id="editSalon" name="salonAdi" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Sıra</label>
                        <input type="number" class="form-control" id="editSira" name="sira" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Bina</label>
                        <input class="form-control" id="editBina" name="binaNo" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .exam-shell {
        max-width: 100%;
    }

    .exam-header-card .card-body {
        padding: 0.8rem 0.95rem;
    }

    .compact-action-btn {
        padding: 0.2rem 0.5rem;
        font-size: 0.78rem;
    }

    .compact-stat-card {
        font-size: 0.82rem;
    }

    .compact-filters .compact-filter {
        min-width: 140px;
    }

    .seat-row {
        cursor: pointer;
        transition: background-color .15s ease, transform .15s ease;
    }

    .seat-row:hover {
        transform: translateY(-1px);
    }


    /* =========================================================
       SINAV YOKLAMA TABLOSU
       Tek / çift satırlar aynı durum renginin farklı
       alpha değerlerini kullanır.
       ========================================================= */


    /* -------------------------
       VAR
       ------------------------- */

    .seat-row.status-present:nth-child(odd) >td {
        background-color: rgba(17, 233, 161, 0.12) !important;
        border: 2px solid rgba(17, 233, 161, 0.35) !important;
    }

    .seat-row.status-present:nth-child(even) >td {
        background-color: rgba(17, 233, 161, 0.20) !important;
        border: 2px solid rgba(17, 233, 161, 0.45) !important   ;
    }


    /* -------------------------
       YOK
       ------------------------- */

    .seat-row.status-absent:nth-child(odd) >td {
        background-color: rgba(239, 68, 68, 0.07)   !important;
        border-left: 6px solid #ef4444 !important;
    }


@model yoklamaWeb.Models.TemporaryProctor
@{
    ViewData["Title"] = "Yoklamacı Düzenle";
    Layout = "_Layout";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="mb-4" style="font-family: 'Outfit', sans-serif; color: #2c3e50;">Yoklamacı Düzenle</h2>
    <div class="card shadow-sm" style="border-radius: 12px; overflow: hidden; backdrop-filter: blur(8px); background: rgba(255,255,255,0.2);">
        <div class="card-body">
            <h5 class="card-title text-muted mb-3">Sınav: @ViewBag.ExamName</h5>
            <form asp-action="EditProctor" method="post" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ExamId" />
                <input type="hidden" asp-for="UserId" />

                <div class="col-md-12">
                    <label class="form-label">Kullanıcı Adı</label>
                    <input class="form-control" value="@Model.User?.UserName" disabled />
                </div>

                <div class="col-md-12">
                    <label asp-for="Room" class="form-label">Salon Adı</label>
                    <input asp-for="Room" class="form-control" placeholder="Örn: Salon 1" required />
                    <span asp-validation-for="Room" class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Password" class="form-label">Şifre (Değiştirmek istemiyorsanız mevcut şifreyi yazın)</label>
                    <input asp-for="Password" class="form-control" placeholder="Şifre" required />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ValidFrom" class="form-label">Başlangıç Tarihi</label>
                    <input asp-for="ValidFrom" class="form-control" type="date" required />
                    <span asp-validation-for="ValidFrom" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ValidTo" class="form-label">Bitiş Tarihi</label>
                    <input asp-for="ValidTo" class="form-control" type="date" required />
                    <span asp-validation-for="ValidTo" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="StartTime" class="form-label">Başlangıç Saati</label>
                    <input asp-for="StartTime" class="form-control" type="time" />
                    <span asp-validation-for="StartTime" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="EndTime" class="form-label">Bitiş Saati</label>
                    <input asp-for="EndTime" class="form-control" type="time" />
                    <span asp-validation-for="EndTime" class="text-danger"></span>
                </div>

                <div class="col-12 mt-4">
                    <button type="submit" class="btn btn-primary btn-sm">Kaydet</button>
                    <a asp-action="Proctors" asp-route-id="@Model.ExamId" class="btn btn-outline-secondary btn-sm ms-2">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

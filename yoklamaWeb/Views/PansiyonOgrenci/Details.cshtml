@model yoklamaWeb.ViewModels.Pansiyon.PansiyonOgrenciViewModel
@{
    ViewData["Title"] = "Öğrenci Detayları";
    Layout = "_Layout";
}

<div class="container mt-4">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Öğrenci Listesine Dön</a>
    </div>

    <div class="row">
        <!-- Sol Sütun: Öğrenci Künye Bilgileri -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white text-center py-4">
                    <i class="bi bi-person-circle" style="font-size: 4rem;"></i>
                    <h4 class="mt-2 mb-0 fw-bold">@Model.AdSoyad</h4>
                    <span class="text-white-50">No: @Model.OgrenciNo</span>
                </div>
                <div class="card-body">
                    <table class="table table-borderless align-middle mb-0 small">
                        <tr>
                            <td class="fw-bold text-muted" style="width: 40%;">Durum:</td>
                            <td>
                                @if (Model.Aktif)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-muted">Sınıf/Şube:</td>
                            <td>@Model.SinifDuzeyi. Sınıf / @Model.Sube</td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-muted">Oda No:</td>
                            <td>
                                @if (Model.OdaId.HasValue)
                                {
                                    <a asp-controller="Oda" asp-action="Details" asp-route-id="@Model.OdaId" class="fw-bold text-primary" style="text-decoration: none;">Oda @Model.OdaNo</a>
                                }
                                else
                                {
                                    <span class="text-danger">Atanmamış</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-muted">Telefon:</td>
                            <td>@(Model.Telefon ?? "-")</td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-muted">Veli Telefon:</td>
                            <td>@(Model.VeliTelefon ?? "-")</td>
                        </tr>
                        <tr>
                            <td class="fw-bold text-muted">Kayıt Tarihi:</td>
                            <td>@Model.KayitTarihi.ToString("dd.MM.yyyy")</td>
                        </tr>
                        @if (!string.IsNullOrEmpty(Model.Adres))
                        {
                            <tr>
                                <td class="fw-bold text-muted" colspan="2">Adres:</td>
                            </tr>
                            <tr>
                                <td colspan="2" class="bg-light p-2 rounded text-wrap small">@Model.Adres</td>
                            </tr>
                        }
                    </table>
                </div>
                <div class="card-footer bg-white border-0 d-flex gap-2 p-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning flex-fill fw-semibold">
        <i class="bi bi-pencil"></i> Düzenle
    </a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger flex-fill fw-semibold">
        <i class="bi bi-trash"></i> Sil
    </a>
</div>
</div>
            </div>
        </div>

        <!-- Sağ Sütun: Yoklama ve İzin Geçmişi Tabları -->
        <div class="col-md-8 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <ul class="nav nav-tabs card-header-tabs" id="myTab" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-bold text-dark" id="yoklama-tab" data-bs-toggle="tab" data-bs-target="#yoklama" type="button" role="tab" aria-controls="yoklama" aria-selected="true"><i class="bi bi-clipboard-check text-success"></i> Yoklama Geçmişi (Son 30)</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold text-dark" id="izin-tab" data-bs-toggle="tab" data-bs-target="#izin" type="button" role="tab" aria-controls="izin" aria-selected="false"><i class="bi bi-calendar-x text-warning"></i> İzin Kayıtları</button>
                        </li>
                    </ul>
                </div>
                <div class="card-body p-0">
                    <div class="tab-content" id="myTabContent">
                        <!-- Yoklama Geçmişi Sekmesi -->
                        <div class="tab-pane fade show active" id="yoklama" role="tabpanel" aria-labelledby="yoklama-tab">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Tarih</th>
                                            <th>Durum</th>
                                            <th>Açıklama</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Yoklamalar.Any())
                                        {
                                            @foreach (var y in Model.Yoklamalar)
                                            {
                                                <tr>
                                                    <td class="ps-3">@y.Tarih.ToString("dd.MM.yyyy")</td>
                                                    <td>
                                                        @if (y.VarMi)
                                                        {
                                                            <span class="badge bg-success">Var</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger">Yok / İzinli</span>
                                                        }
                                                    </td>
                                                    <td>@(y.Aciklama ?? "-")</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="3" class="text-center text-muted py-4">Bu öğrenciye ait yoklama kaydı bulunamadı.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- İzin Kayıtları Sekmesi -->
                        <div class="tab-pane fade" id="izin" role="tabpanel" aria-labelledby="izin-tab">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">İzin Türü</th>
                                            <th>Başlangıç Tarihi</th>
                                            <th>Bitiş Tarihi</th>
                                            <th>Gün</th>
                                            <th>Açıklama</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Izinler.Any())
                                        {
                                            @foreach (var i in Model.Izinler)
                                            {
                                                var gunSayisi = (i.BitisTarihi - i.BaslangicTarihi).Days + 1;
                                                <tr>
                                                    <td class="ps-3"><strong class="text-warning">@i.IzinTuru</strong></td>
                                                    <td>@i.BaslangicTarihi.ToString("dd.MM.yyyy")</td>
                                                    <td>@i.BitisTarihi.ToString("dd.MM.yyyy")</td>
                                                    <td>@gunSayisi Gün</td>
                                                    <td>@(i.Aciklama ?? "-")</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center text-muted py-4">Bu öğrenciye ait izin kaydı bulunamadı.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

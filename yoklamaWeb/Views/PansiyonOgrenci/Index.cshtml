@model yoklamaWeb.ViewModels.Pansiyon.PansiyonOgrenciListViewModel
@{
    ViewData["Title"] = "Pansiyon Öğrencileri";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Pansiyon Öğrenci Listesi</h2>
        <div>
            <a asp-action="Create" class="btn btn-primary me-2"><i class="bi bi-plus-circle"></i> Yeni Öğrenci Ekle</a>
            <a asp-action="Import" class="btn btn-success me-2"><i class="bi bi-file-earmark-excel"></i> Excel'den Yükle</a>
            <a asp-action="Export" class="btn btn-outline-success"><i class="bi bi-file-earmark-arrow-down"></i> Excel'e Aktar</a>
        </div>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Arama</label>
                    <input type="text" name="Arama" value="@Model.Filter.Arama" class="form-control" placeholder="Ad, soyad, öğrenci no..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Oda</label>
                    <select name="OdaId" asp-items="ViewBag.Odalar" class="form-select">
                        <option value="">-- Tüm Odalar --</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Sınıf</label>
                    <select name="SinifDuzeyi" asp-items="ViewBag.SinifDuzeyleri" class="form-select">
                        <option value="">-- Tümü --</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input type="checkbox" name="Aktif" value="true" class="form-check-input" id="sadeceAktifCheck" @(Model.Filter.SadeceAktif ? "checked" : "") />
                        <label class="form-check-label" for="sadeceAktifCheck">Sadece Aktifler</label>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-secondary w-100">Filtrele</button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Öğrenci No</th>
                    <th>Ad Soyad</th>
                    <th>Sınıf / Şube</th>
                    <th>Oda No</th>
                    <th>Telefon</th>
                    <th>Veli Telefon</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Ogrenciler.Any())
                {
                    @foreach (var ogrenci in Model.Ogrenciler)
                    {
                        <tr>
                            <td>@ogrenci.OgrenciNo</td>
                            <td><strong>@ogrenci.AdSoyad</strong></td>
                            <td>@ogrenci.SinifDuzeyi / @ogrenci.Sube</td>
                            <td>@(ogrenci.OdaNo ?? "-")</td>
                            <td>@ogrenci.Telefon</td>
                            <td>@ogrenci.VeliTelefon</td>
                            <td>
                                @if (ogrenci.Aktif)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@ogrenci.Id" class="btn btn-sm btn-info me-1">Detay</a>
                                <a asp-action="Edit" asp-route-id="@ogrenci.Id" class="btn btn-sm btn-warning me-1">Düzenle</a>
                                <a asp-action="Delete" asp-route-id="@ogrenci.Id" class="btn btn-sm btn-danger">Sil</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">Kayıtlı pansiyon öğrencisi bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

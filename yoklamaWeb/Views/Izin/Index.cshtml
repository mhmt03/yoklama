@model yoklamaWeb.ViewModels.Pansiyon.IzinListViewModel
@using yoklamaWeb.Models.Enums
@{
    ViewData["Title"] = "İzin İşlemleri";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>İzin Yönetimi</h2>
        <div>
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Yeni İzin Ekle</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4 shadow-sm border-0 bg-light">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-bold">Öğrenci / Onaylayan / Açıklama</label>
                    <input type="text" name="Arama" value="@Model.Filter.Arama" class="form-control" placeholder="Ara..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">İzin Durumu</label>
                    <select name="Durum" class="form-select">
                        <option value="">-- Tümü --</option>
                        @foreach (var item in ViewBag.Durumlar as List<SelectListItem>)
                        {
                            if (Model.Filter.Durum?.ToString() == item.Text || ((int?)Model.Filter.Durum)?.ToString() == item.Value)
                            {
                                <option value="@item.Value" selected>@item.Text</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">İzin Türü</label>
                    <select name="Tur" class="form-select">
                        <option value="">-- Tümü --</option>
                        @foreach (var item in ViewBag.Turler as List<SelectListItem>)
                        {
                            if (Model.Filter.Tur?.ToString() == item.Text || ((int?)Model.Filter.Tur)?.ToString() == item.Value)
                            {
                                <option value="@item.Value" selected>@item.Text</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Başlangıç Tarihi</label>
                    <input type="date" name="BaslangicTarihi" value="@(Model.Filter.BaslangicTarihi?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold">Bitiş Tarihi</label>
                    <input type="date" name="BitisTarihi" value="@(Model.Filter.BitisTarihi?.ToString("yyyy-MM-dd"))" class="form-control" />
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-secondary w-100">Filtrele</button>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th class="ps-3">Öğrenci No</th>
                    <th>Ad Soyad</th>
                    <th>Tür</th>
                    <th>Başlangıç Tarihi</th>
                    <th>Bitiş Tarihi</th>
                    <th>Durum</th>
                    <th>Onaylayan</th>
                    <th class="text-end pe-3" style="min-width: 250px;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Izinler.Any())
                {
                    @foreach (var izin in Model.Izinler)
                    {
                        <tr>
                            <td class="ps-3">@izin.OgrenciNo</td>
                            <td><strong>@izin.OgrenciAdSoyad</strong></td>
                            <td>
                                <span class="badge bg-info text-dark">@izin.Tur.ToString()</span>
                            </td>
                            <td>@izin.BaslangicTarihi.ToString("dd.MM.yyyy")</td>
                            <td>@izin.BitisTarihi.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (izin.Durum == IzinDurum.Bekliyor)
                                {
                                    <span class="badge bg-warning text-dark">Bekliyor</span>
                                }
                                else if (izin.Durum == IzinDurum.Onaylandi)
                                {
                                    <span class="badge bg-success">Onaylandı</span>
                                }
                                else if (izin.Durum == IzinDurum.Reddedildi)
                                {
                                    <span class="badge bg-danger">Reddedildi</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">İptal Edildi</span>
                                }
                            </td>
                            <td>@(izin.OnaylayanAdSoyad ?? "-")</td>
                            <td class="text-end pe-3">
                                <a asp-action="Details" asp-route-id="@izin.Id" class="btn btn-sm btn-info me-1"><i class="bi bi-eye"></i> Detay</a>
                                
                                @if (izin.Durum == IzinDurum.Bekliyor)
                                {
                                    <form asp-action="Onayla" asp-route-id="@izin.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(izin.RowVersion)" />
                                        <button type="submit" class="btn btn-sm btn-success me-1"><i class="bi bi-check-circle"></i> Onayla</button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-danger me-1" data-bs-toggle="modal" data-bs-target="#redModal_@izin.Id"><i class="bi bi-x-circle"></i> Reddet</button>
                                    
                                    <!-- Red Modalı -->
                                    <div class="modal fade text-start" id="redModal_@izin.Id" tabindex="-1" aria-labelledby="redModalLabel_@izin.Id" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <form asp-action="Reddet" asp-route-id="@izin.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="rowVersion" value="@Convert.ToBase64String(izin.RowVersion)" />
                                                    <div class="modal-header bg-danger text-white">
                                                        <h5 class="modal-title" id="redModalLabel_@izin.Id">İzin Reddetme Gerekçesi</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p><strong>@izin.OgrenciAdSoyad</strong> isimli öğrencinin izin talebini reddetmek üzeresiniz. Lütfen bir ret gerekçesi yazınız:</p>
                                                        <div class="mb-3">
                                                            <label for="redSebebi_@izin.Id" class="form-label fw-bold">Ret Nedeni</label>
                                                            <input type="text" class="form-control" id="redSebebi_@izin.Id" name="redSebebi" required placeholder="Gerekçe yazınız..." />
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                                                        <button type="submit" class="btn btn-danger">Reddet</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                                
                                <a asp-action="Edit" asp-route-id="@izin.Id" class="btn btn-sm btn-warning me-1"><i class="bi bi-pencil"></i> Düzenle</a>
                                <a asp-action="Delete" asp-route-id="@izin.Id" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Sil</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">Kayıtlı izin bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

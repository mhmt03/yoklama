@model yoklamaWeb.ViewModels.Pansiyon.IzinCreateViewModel
@{
    ViewData["Title"] = "Yeni İzin Kaydı Ekle";
    Layout = "_Layout";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0 fw-bold">Yeni İzin Kaydı Ekle</h4>
        </div>
        <div class="card-body p-4">
            <div class="alert alert-light border p-2 mb-3 text-muted small">
                <i class="bi bi-info-circle text-primary"></i> <span class="text-danger fw-bold">*</span> ile işaretli alanların doldurulması zorunludur.
            </div>

            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="OgrenciId" class="form-label fw-bold">Öğrenci <span class="text-danger">*</span></label>
                    <select asp-for="OgrenciId" asp-items="ViewBag.Ogrenciler" class="form-select">
                        <option value="">-- Öğrenci Seçiniz --</option>
                    </select>
                    <span asp-validation-for="OgrenciId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Tur" class="form-label fw-bold">İzin Türü <span class="text-danger">*</span></label>
                    <select asp-for="Tur" asp-items="ViewBag.Turler" class="form-select"></select>
                    <span asp-validation-for="Tur" class="text-danger"></span>
                </div>

                <div class="mb-3 bg-light p-3 rounded border" id="yoklamaSecimiDiv" style="display:none;">
                    <label class="form-label fw-bold d-block"><i class="bi bi-list-check"></i> İzinli Olacağı Yoklama Numaraları</label>
                    @foreach (var tur in ViewBag.YoklamaTurleri as List<yoklamaWeb.Models.YoklamaTuru> ?? new List<yoklamaWeb.Models.YoklamaTuru>())
                    {
                        <div class="form-check form-check-inline">
                            <input class="form-check-input yoklama-chk" type="checkbox" id="yoklama_@tur.Id" value="@tur.Id">
                            <label class="form-check-label" for="yoklama_@tur.Id">@tur.Ad</label>
                        </div>
                    }
                    <input type="hidden" asp-for="IzinliYoklamaNolar" id="IzinliYoklamaNolar" />
                    <span asp-validation-for="IzinliYoklamaNolar" class="text-danger d-block mt-1"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="BaslangicTarihi" class="form-label fw-bold">Başlangıç Tarihi <span class="text-danger">*</span></label>
                        <input asp-for="BaslangicTarihi" type="date" class="form-control" />
                        <span asp-validation-for="BaslangicTarihi" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="BitisTarihi" class="form-label fw-bold">Bitiş Tarihi <span class="text-danger">*</span></label>
                        <input asp-for="BitisTarihi" type="date" class="form-control" />
                        <span asp-validation-for="BitisTarihi" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3 bg-light p-3 rounded border">
                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-1">
                        <label class="form-label fw-bold mb-0"><i class="bi bi-calendar-week"></i> İzinli Olacağı Günler <span class="text-muted fw-normal small">(İsteğe Bağlı)</span></label>
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-primary py-0" id="btnHaftaIci">Hafta İçi</button>
                            <button type="button" class="btn btn-sm btn-outline-primary py-0" id="btnHaftaSonu">Hafta Sonu</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" id="btnTumunuSec">Tümünü Seç</button>
                            <button type="button" class="btn btn-sm btn-outline-danger py-0" id="btnTemizle">Temizle</button>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 pt-1">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input gun-chk" type="checkbox" name="SecilenGunler" id="gun_Monday" value="Monday" @(Model.SecilenGunler != null && Model.SecilenGunler.Contains(DayOfWeek.Monday) ? "checked" : "")>
                            <label class="form-check-label" for="gun_Monday">Pazartesi</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input gun-chk" type="checkbox" name="SecilenGunler" id="gun_Tuesday" value="Tuesday" @(Model.SecilenGunler != null && Model.SecilenGunler.Contains(DayOfWeek.Tuesday) ? "checked" : "")>
                            <label class="form-check-label" for="gun_Tuesday">Salı</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input gun-chk" type="checkbox" name="SecilenGunler" id="gun_Wednesday" value="Wednesday" @(Model.SecilenGunler != null && Model.SecilenGunler.Contains(DayOfWeek.Wednesday) ? "checked" : "")>
                            <label class="form-check-label" for="gun_Wednesday">Çarşamba</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input gun-chk" type="checkbox" name="SecilenGunler" id="gun_Thursday" value="Thursday" @(Model.SecilenGunler != null && Model.SecilenGunler.Contains(DayOfWeek.Thursday) ? "checked" : "")>
                            <label class="form-check-label" for="gun_Thursday">Perşembe</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input gun-chk" type="checkbox" name="SecilenGunler" id="gun_Friday" value="Friday" @(Model.SecilenGunler != null && Model.SecilenGunler.Contains(DayOfWeek.Friday) ? "checked" : "")>
                            <label class="form-check-label" for="gun_Friday">Cuma</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input gun-chk" type="checkbox" name="SecilenGunler" id="gun_Saturday" value="Saturday" @(Model.SecilenGunler != null && Model.SecilenGunler.Contains(DayOfWeek.Saturday) ? "checked" : "")>
                            <label class="form-check-label" for="gun_Saturday">Cumartesi</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input gun-chk" type="checkbox" name="SecilenGunler" id="gun_Sunday" value="Sunday" @(Model.SecilenGunler != null && Model.SecilenGunler.Contains(DayOfWeek.Sunday) ? "checked" : "")>
                            <label class="form-check-label" for="gun_Sunday">Pazar</label>
                        </div>
                    </div>
                    <small class="text-muted d-block mt-2"><i class="bi bi-info-circle"></i> Seçim yapılmazsa tarih aralığındaki tüm günler izinli sayılır.</small>
                </div>

                <div class="mb-3">
                    <label asp-for="Durum" class="form-label fw-bold">Başlangıç Durumu <span class="text-danger">*</span></label>
                    <select asp-for="Durum" asp-items="ViewBag.Durumlar" class="form-select"></select>
                    <span asp-validation-for="Durum" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Aciklama" class="form-label fw-bold">Açıklama <span class="text-muted fw-normal small">(İsteğe Bağlı)</span></label>
                    <textarea asp-for="Aciklama" class="form-control" rows="3" placeholder="İzin gerekçesi, adres veya notlar (isteğe bağlı)..."></textarea>
                    <span asp-validation-for="Aciklama" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const turSelect = document.getElementById("Tur");
            const yoklamaDiv = document.getElementById("yoklamaSecimiDiv");
            const checkboxes = document.querySelectorAll(".yoklama-chk");
            const hiddenInput = document.getElementById("IzinliYoklamaNolar");

            function toggleYoklamaDiv() {
                // "4" represents IzinTur.GecGelme
                if (turSelect.value === "4") {
                    yoklamaDiv.style.display = "block";
                } else {
                    yoklamaDiv.style.display = "none";
                    hiddenInput.value = "";
                    checkboxes.forEach(c => c.checked = false);
                }
            }

            function updateHiddenInput() {
                const selected = Array.from(checkboxes)
                    .filter(c => c.checked)
                    .map(c => c.value);
                hiddenInput.value = selected.join(",");
            }

            if (turSelect) {
                turSelect.addEventListener("change", toggleYoklamaDiv);
                toggleYoklamaDiv();
            }

            checkboxes.forEach(c => {
                c.addEventListener("change", updateHiddenInput);
            });

            // Hızlı gün seçim butonları
            const gunCheckboxes = document.querySelectorAll(".gun-chk");
            const haftaIciGunler = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"];
            const haftaSonuGunler = ["Saturday", "Sunday"];

            document.getElementById("btnHaftaIci")?.addEventListener("click", function() {
                gunCheckboxes.forEach(c => c.checked = haftaIciGunler.includes(c.value));
            });

            document.getElementById("btnHaftaSonu")?.addEventListener("click", function() {
                gunCheckboxes.forEach(c => c.checked = haftaSonuGunler.includes(c.value));
            });

            document.getElementById("btnTumunuSec")?.addEventListener("click", function() {
                gunCheckboxes.forEach(c => c.checked = true);
            });

            document.getElementById("btnTemizle")?.addEventListener("click", function() {
                gunCheckboxes.forEach(c => c.checked = false);
            });
        });
    </script>
}

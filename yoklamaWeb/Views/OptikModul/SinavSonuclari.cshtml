@model IEnumerable<yoklamaWeb.Models.OptikSinavSonuc>
@{
    ViewData["Title"] = "Sınav Sonuçları";
}

<div class="container-fluid py-4">
    <h2 class="mb-4"><i class="bi bi-trophy text-primary me-2"></i>Sınav Sonuçları Raporu</h2>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body bg-light">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label fw-bold">Sınav Filtresi</label>
                    <select name="sinavId" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Tüm Sınavlar --</option>
                        @foreach (var sinav in ViewBag.Sinavlar)
                        {
                            if (ViewBag.SeciliSinavId != null && ViewBag.SeciliSinavId.ToString() == sinav.Id.ToString())
                            {
                                <option value="@sinav.Id" selected>@sinav.SinavAdi (@sinav.UygulamaTarihi.ToString("dd.MM.yyyy"))</option>
                            }
                            else
                            {
                                <option value="@sinav.Id">@sinav.SinavAdi (@sinav.UygulamaTarihi.ToString("dd.MM.yyyy"))</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Öğrenci No (Opsiyonel)</label>
                    <input type="text" name="ogrenciNo" class="form-control" value="@ViewBag.SeciliOgrenciNo" placeholder="Örn: 1453">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search me-1"></i> Filtrele</button>
                </div>
                <div class="col-md-2">
                    <a asp-action="SinavSonuclari" class="btn btn-outline-secondary w-100"><i class="bi bi-x-circle me-1"></i> Temizle</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle w-100" id="raporTable">
                    <thead class="table-dark">
                        <tr>
                            <th>Sınav Adı</th>
                            <th>Sınıf</th>
                            <th>Öğrenci No</th>
                            <th>Ad Soyad</th>
                            <th>Top. Doğru</th>
                            <th>Top. Yanlış</th>
                            <th>Top. Boş</th>
                            <th>Top. Net</th>
                            <th>Ders Detayları (D/Y/B/N)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.OptikSinav.SinavAdi</td>
                                <td>@(item.Ogrenci != null ? item.Ogrenci.SinifDuzeyi + item.Ogrenci.Sube : "-")</td>
                                <td class="fw-bold">@item.OgrenciNo</td>
                                <td>@(item.Ogrenci != null ? item.Ogrenci.AdSoyad : "-")</td>
                                <td class="text-success fw-bold">@item.ToplamDogru</td>
                                <td class="text-danger fw-bold">@item.ToplamYanlis</td>
                                <td class="text-secondary fw-bold">@item.ToplamBos</td>
                                <td class="text-primary fw-bold fs-5">@item.ToplamNet</td>
                                <td>
                                    @if(item.DersSonuclari != null && item.DersSonuclari.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                        @foreach(var ders in item.DersSonuclari)
                                        {
                                            <span class="badge bg-light text-dark border">
                                                <strong>@ders.DersAdi:</strong> @ders.Dogru / @ders.Yanlis / @ders.Bos / <span class="text-primary">@ders.Net</span>
                                            </span>
                                        }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    
    <!-- Export Butonları için Gerekli Kütüphaneler -->
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>

    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css" rel="stylesheet" />

    <script>
        $(document).ready(function() {
            $('#raporTable').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json' },
                pageLength: 50,
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="bi bi-file-earmark-excel"></i> Excel\'e Aktar',
                        className: 'btn btn-success mb-3'
                    },
                    {
                        extend: 'print',
                        text: '<i class="bi bi-printer"></i> Yazdır',
                        className: 'btn btn-secondary mb-3'
                    }
                ]
            });
        });
    </script>
}

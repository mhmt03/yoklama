@model yoklamaWeb.Models.OptikForm
@{
    ViewData["Title"] = "Form Düzenle";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><i class="bi bi-pencil-square text-primary me-2"></i>Optik Form Düzenle</h2>
        <a asp-action="FormTanimla" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Geri Dön
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <form asp-action="FormDuzenle" method="post" id="formDuzenleForm">
                <input type="hidden" asp-for="Id" />
                
                <div class="row g-3 mb-4">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Form Adı</label>
                        <input type="text" asp-for="FormAdi" class="form-control" required>
                    </div>
                    
                    <h6 class="mt-4 mb-2 fw-bold text-primary border-bottom pb-2">Öğrenci Bilgileri Parametreleri (0'dan Başlar)</h6>
                    
                    <div class="col-md-6">
                        <label class="form-label">Öğrenci No Başlangıç Sütunu</label>
                        <input type="number" asp-for="NumaraBaslangic" class="form-control" required min="0">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Öğrenci No Karakter Sayısı</label>
                        <input type="number" asp-for="NumaraUzunluk" class="form-control" required min="1">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Ad Soyad Başlangıç Sütunu</label>
                        <input type="number" asp-for="AdSoyadBaslangic" class="form-control" required min="0">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ad Soyad Karakter Sayısı</label>
                        <input type="number" asp-for="AdSoyadUzunluk" class="form-control" required min="1">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Sınıf Başlangıç Sütunu</label>
                        <input type="number" asp-for="SinifBaslangic" class="form-control" required min="0">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Sınıf Karakter Sayısı</label>
                        <input type="number" asp-for="SinifUzunluk" class="form-control" required min="1">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-muted">Kitapçık Türü Bşl. Sütunu (Opsiyonel)</label>
                        <input type="number" asp-for="KitapcikTuruBaslangic" class="form-control" min="0" placeholder="Örn: 15">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">Kitapçık Türü Krk. Sayısı (Opsiyonel)</label>
                        <input type="number" asp-for="KitapcikTuruUzunluk" class="form-control" min="1" placeholder="Genelde 1">
                    </div>
                </div>

                <h6 class="mt-4 mb-2 fw-bold text-primary border-bottom pb-2 d-flex justify-content-between align-items-center">
                    Ders Parametreleri
                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnDersEkle">
                        <i class="bi bi-plus"></i> Ders Ekle
                    </button>
                </h6>
                
                <div id="derslerContainer">
                    @if (Model.Dersler != null && Model.Dersler.Any())
                    {
                        foreach (var ders in Model.Dersler)
                        {
                            <div class="row g-2 mb-2 pb-2 border-bottom ders-row align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label small text-muted">Ders Adı</label>
                                    <input type="text" class="form-control ders-adi" required value="@ders.DersAdi">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small text-muted">Başlangıç Sütunu</label>
                                    <input type="number" class="form-control ders-baslangic" required min="0" value="@ders.BaslangicSutun">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small text-muted">Karakter(Soru) Sayısı</label>
                                    <input type="number" class="form-control ders-karakter" required min="1" value="@ders.KarakterSayisi">
                                </div>
                                <div class="col-md-2">
                                    <button type="button" class="btn btn-outline-danger w-100 btnDersSil"><i class="bi bi-trash"></i></button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info text-center" id="noDersAlert">Henüz ders eklenmedi.</div>
                    }
                </div>

                <input type="hidden" name="derslerJson" id="derslerJson">

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-primary px-4" onclick="prepareJson()">Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<template id="dersTemplate">
    <div class="row g-2 mb-2 pb-2 border-bottom ders-row align-items-end">
        <div class="col-md-4">
            <label class="form-label small text-muted">Ders Adı</label>
            <input type="text" class="form-control ders-adi" required>
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted">Başlangıç Sütunu</label>
            <input type="number" class="form-control ders-baslangic" required min="0">
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted">Karakter(Soru) Sayısı</label>
            <input type="number" class="form-control ders-karakter" required min="1">
        </div>
        <div class="col-md-2">
            <button type="button" class="btn btn-outline-danger w-100 btnDersSil"><i class="bi bi-trash"></i></button>
        </div>
    </div>
</template>

@section Scripts {
    <script>
        document.getElementById('btnDersEkle').addEventListener('click', function() {
            var alertEl = document.getElementById('noDersAlert');
            if (alertEl) alertEl.style.display = 'none';
            var template = document.getElementById('dersTemplate').content.cloneNode(true);
            document.getElementById('derslerContainer').appendChild(template);
        });

        document.getElementById('derslerContainer').addEventListener('click', function(e) {
            if(e.target.closest('.btnDersSil')) {
                e.target.closest('.ders-row').remove();
                if(document.querySelectorAll('.ders-row').length === 0) {
                    var alertEl = document.getElementById('noDersAlert');
                    if(alertEl) alertEl.style.display = 'block';
                }
            }
        });

        function prepareJson() {
            var dersler = [];
            var rows = document.querySelectorAll('.ders-row');
            rows.forEach(function(row) {
                dersler.push({
                    DersAdi: row.querySelector('.ders-adi').value,
                    BaslangicSutun: parseInt(row.querySelector('.ders-baslangic').value),
                    KarakterSayisi: parseInt(row.querySelector('.ders-karakter').value)
                });
            });
            document.getElementById('derslerJson').value = JSON.stringify(dersler);
        }
    </script>
}

@model yoklamaWeb.Models.Ogrenci
@{
    ViewData["Title"] = "Öğrenci Sil";
}
<h2 class="mt-4">Öğrenci Sil</h2>
<div class="alert alert-danger" role="alert">
    Bu öğrenciyi silmek istediğinizden emin misiniz?
</div>
<div class="mb-3">
    <dl class="row">
        <dt class="col-sm-3">Öğrenci No</dt>
        <dd class="col-sm-9">@Model.OgrenciNo</dd>
        <dt class="col-sm-3">Ad Soyad</dt>
        <dd class="col-sm-9">@Model.AdSoyad</dd>
    </dl>
</div>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="OgrenciNo" />
    <button type="submit" class="btn btn-danger">Sil</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">İptal</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@inject yoklamaWeb.Data.AppDbContext _context
@{
    bool isGlobalAdmin = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin");
    bool isPansiyonAdmin = false;
    bool isPansiyonGorevlisi = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("PansiyonGorevlisi");

    if (isPansiyonGorevlisi && User.Identity?.Name != null)
    {
        var gorevli = _context.PansiyonGorevlileri.FirstOrDefault(g => g.KullaniciAdi == User.Identity.Name);
        if (gorevli != null && gorevli.Rol == "Admin" && gorevli.Aktif)
        {
            isPansiyonAdmin = true;
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - yoklamaWeb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/yoklamaWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
@if (ViewContext.RouteData.Values["controller"]?.ToString() == "Admin")
{
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}
</head>
<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Yoklamacı</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            @if (isGlobalAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Exam" asp-action="Index">Sınavlar</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Ogrenci" asp-action="Index">Öğrenciler</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark" href="#" id="pansiyonDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Pansiyon Modülü
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="pansiyonDropdown">
                                        <li><a class="dropdown-item" asp-controller="Yoklama" asp-action="GunlukYoklama">Günlük Yoklama Girişi</a></li>
                                        <li><a class="dropdown-item" asp-controller="Yoklama" asp-action="Index">Yoklama Listesi & Geçmişi</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Izin" asp-action="Index">İzin İşlemleri</a></li>
                                        <li><a class="dropdown-item" asp-controller="Izin" asp-action="Create">İzin Ekle</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="PansiyonOgrenci" asp-action="Index">Pansiyon Öğrencileri</a></li>
                                        <li><a class="dropdown-item" asp-controller="Oda" asp-action="Index">Oda Yönetimi</a></li>
                                        <li><a class="dropdown-item" asp-controller="NobetciPlan" asp-action="Index">Nöbetçi Planı</a></li>
                                        <li><a class="dropdown-item" asp-controller="PansiyonGorevlisi" asp-action="Index">Pansiyon Görevlileri</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="Index">Kullanıcı Yönetimi</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="ClassAttendance" asp-action="Index">Sınıf Yoklaması</a>
                                </li>
                            }
                            else if (isPansiyonAdmin)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-dark fw-bold" href="#" id="pansiyonDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Pansiyon Modülü
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="pansiyonDropdown">
                                        <li><a class="dropdown-item" asp-controller="Yoklama" asp-action="GunlukYoklama">Günlük Yoklama Girişi</a></li>
                                        <li><a class="dropdown-item" asp-controller="Yoklama" asp-action="Index">Yoklama Listesi & Geçmişi</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Izin" asp-action="Index">İzin İşlemleri</a></li>
                                        <li><a class="dropdown-item" asp-controller="Izin" asp-action="Create">İzin Ekle</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="PansiyonOgrenci" asp-action="Index">Pansiyon Öğrencileri</a></li>
                                        <li><a class="dropdown-item" asp-controller="Oda" asp-action="Index">Oda Yönetimi</a></li>
                                        <li><a class="dropdown-item" asp-controller="NobetciPlan" asp-action="Index">Nöbetçi Planı</a></li>
                                        <li><a class="dropdown-item" asp-controller="PansiyonGorevlisi" asp-action="Index">Pansiyon Görevlileri</a></li>
                                    </ul>
                                </li>
                            }
                            else if (isPansiyonGorevlisi || User.IsInRole("PansiyonNobetcisi"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark fw-bold" asp-controller="Yoklama" asp-action="GunlukYoklama">Günlük Yoklama Girişi</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Yoklama" asp-action="Index">Yoklama Geçmişi</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Izin" asp-action="Create">İzin Talebi Ekle</a>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav ms-auto align-items-center">
                            <li class="nav-item me-3">
                                <span class="text-dark">Merhaba, <strong>@User.Identity.Name</strong></span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link text-danger p-0" style="text-decoration: none;">Çıkış Yap</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - created By Mehmet Gündöner
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

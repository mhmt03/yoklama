@model IEnumerable<yoklamaWeb.Models.AdminUserListItemModel>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="container mt-4">
    <div class="d-flex flex-column flex-md-row align-items-md-end justify-content-between mb-4 gap-3">
        <div>
            <h2>Kullanıcı Yönetimi</h2>
            <p class="text-muted mb-0">Sistemdeki kullanıcıları görüntüleyin, düzenleyin veya silin.</p>
        </div>
        <a asp-action="CreateUser" class="btn btn-success">Yeni Kullanıcı</a>
    </div>

    @if (TempData["AdminError"] != null)
    {
        <div class="alert alert-warning">@TempData["AdminError"]</div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Kullanıcı Adı</th>
                    <th>Rol</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.UserName</td>
                        <td>@user.Role</td>
                        <td class="text-end">
                            <a asp-action="EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-primary me-2">Düzenle</a>
                            <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="d-inline" onsubmit="return confirm('Kullanıcıyı silmek istediğinizden emin misiniz?');">
                                <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

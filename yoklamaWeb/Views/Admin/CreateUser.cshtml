@model yoklamaWeb.Models.AdminUserCreateModel

@{
    ViewData["Title"] = "Yeni Kullanıcı Oluştur";
}

<div class="container mt-4">
    <h2>Yeni Kullanıcı Oluştur</h2>
    <form asp-action="CreateUser" method="post" class="needs-validation" novalidate>
        <div class="mb-3">
            <label asp-for="UserName" class="form-label"></label>
            <input asp-for="UserName" class="form-control" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Role" class="form-label"></label>
            <select asp-for="Role" asp-items="Model.Roles" class="form-select"></select>
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Oluştur</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Geri</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

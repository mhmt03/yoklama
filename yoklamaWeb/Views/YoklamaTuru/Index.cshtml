@model IEnumerable<yoklamaWeb.Models.YoklamaTuru>
@{
    ViewData["Title"] = "Yoklama Çeşitleri Yönetimi";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary mb-0"><i class="bi bi-list-stars me-1"></i> Yoklama Çeşitleri</h2>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Yeni Yoklama Çeşidi Ekle</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filtreleme Kartı -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body py-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <input type="text" name="arama" value="@ViewBag.Arama" class="form-control" placeholder="Yoklama çeşidi adı ile ara..." />
                </div>
                <div class="col-md-4 d-flex align-items-center">
                    <div class="form-check ms-2">
                        <input type="checkbox" name="sadeceAktif" value="true" class="form-check-input" id="sadeceAktif" @(ViewBag.SadeceAktif == true ? "checked" : "") />
                        <label class="form-check-label small" for="sadeceAktif">Sadece Aktif Olanları Göster</label>
                    </div>
                </div>
                <div class="col-md-3 d-grid gap-2 d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-secondary px-4">Filtrele</button>
                    @if (!string.IsNullOrEmpty(ViewBag.Arama) || ViewBag.SadeceAktif == true)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Liste -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3" style="width: 10%;">Sıra</th>
                            <th>Yoklama Adı</th>
                            <th style="width: 15%;">Durum</th>
                            <th style="width: 25%;">Oluşturma Tarihi</th>
                            <th class="text-end pe-3" style="width: 20%;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">@item.Sira</td>
                                    <td class="fw-semibold">@item.Ad</td>
                                    <td>
                                        @if (item.Aktif)
                                        {
                                            <span class="badge bg-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Pasif</span>
                                        }
                                    </td>
                                    <td>@item.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td class="text-end pe-3">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning text-white"><i class="bi bi-pencil-square"></i> Düzenle</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger"><i class="bi bi-trash"></i> Sil</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">Kayıtlı yoklama çeşidi bulunamadı.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@model yoklamaWeb.Models.YoklamaTuru
@{
    ViewData["Title"] = "Yoklama Çeşidi Sil";
    Layout = "_Layout";
}

<div class="container mt-4" style="max-width: 500px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0 fw-bold">Yoklama Çeşidi Silme Onayı</h4>
        </div>
        <div class="card-body p-4 text-center">
            <div class="mb-4">
                <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
            </div>
            
            <p class="lead"><strong>@Model.Ad</strong> isimli yoklama çeşidini silmek istediğinizden emin misiniz?</p>
            
            <div class="alert alert-warning text-start small">
                <strong>Dikkat:</strong> Bu yoklama çeşidine ait geçmiş yoklama verileri bulunuyorsa silme işlemine izin verilmeyecektir. Bu durumda bunun yerine kaydı **pasif** yapabilirsiniz.
            </div>

            <form method="post" asp-action="Delete">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
                    <button type="submit" class="btn btn-danger fw-semibold px-4">Evet, Sil</button>
                </div>
            </form>
        </div>
    </div>
</div>

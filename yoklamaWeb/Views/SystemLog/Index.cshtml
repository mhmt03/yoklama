@model IEnumerable<yoklamaWeb.Models.SystemLog>
@{
    ViewData["Title"] = "Sistem Log Kayıtları";
    Layout = "_Layout";
    int sayfa = ViewBag.Sayfa;
    int toplamSayfa = ViewBag.ToplamSayfa;
}

<div class="container-fluid mt-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-danger mb-0"><i class="bi bi-shield-lock-fill me-1"></i> Sistem Logları</h2>
        <span class="badge bg-secondary p-2">Toplam Kayıt: @ViewBag.ToplamKayit</span>
    </div>

    <!-- Filtre Kartı -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body py-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold small mb-1">Arama</label>
                    <input type="text" name="arama" value="@ViewBag.Arama" class="form-control form-control-sm" placeholder="Kullanıcı, sayfa, parametre veya IP..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small mb-1">Rol</label>
                    <select name="rol" class="form-select form-select-sm">
                        <option value="">-- Tümü --</option>
                        <option value="Admin" selected="@(ViewBag.SeciliRol == "Admin" ? "selected" : null)">Admin</option>
                        <option value="Idareci" selected="@(ViewBag.SeciliRol == "Idareci" ? "selected" : null)">İdareci</option>
                        <option value="Yoklamaci" selected="@(ViewBag.SeciliRol == "Yoklamaci" ? "selected" : null)">Yoklamacı</option>
                        <option value="SuperYoklamaci" selected="@(ViewBag.SeciliRol == "SuperYoklamaci" ? "selected" : null)">Sınav Yöneticisi</option>
                        <option value="PansiyonGorevlisi" selected="@(ViewBag.SeciliRol == "PansiyonGorevlisi" ? "selected" : null)">Pansiyon Görevlisi</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-bold small mb-1">Metot</label>
                    <select name="metot" class="form-select form-select-sm">
                        <option value="">-- Tümü --</option>
                        <option value="GET" selected="@(ViewBag.SeciliMetot == "GET" ? "selected" : null)">GET</option>
                        <option value="POST" selected="@(ViewBag.SeciliMetot == "POST" ? "selected" : null)">POST</option>
                    </select>
                </div>
                <input type="hidden" name="sayfa" value="1" />
                <div class="col-md-3 d-grid gap-2 d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-danger btn-sm px-4">Sorgula</button>
                    @if (!string.IsNullOrEmpty(ViewBag.Arama) || !string.IsNullOrEmpty(ViewBag.SeciliRol) || !string.IsNullOrEmpty(ViewBag.SeciliMetot))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Temizle</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Liste -->
    <div class="mt-2">
        <form asp-action="DeleteAll" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-warning" onclick="return confirm('Tüm log kayıtları silinsin mi?');">Tüm Logları Temizle</button>
        </form>
    </div>
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0" style="font-size: 0.85rem;">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 15%;">Tarih (UTC)</th>
                            <th style="width: 12%;">Kullanıcı Adı</th>
                            <th style="width: 13%;">Rol</th>
                            <th style="width: 15%;">Sayfa / İşlem</th>
                            <th style="width: 8%;">Metot</th>
                            <th style="width: 10%;">IP Adresi</th>
                            <th>Parametreler</th>
                            <th style="width: 8%;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-nowrap fw-semibold text-muted">@item.Tarih.ToString("dd.MM.yyyy HH:mm:ss")</td>
                                    <td class="fw-bold">@item.KullaniciAdi</td>
                                    <td>
                                        <span class="badge bg-secondary">@item.Rol</span>
                                    </td>
                                    <td>
                                        <span class="text-primary fw-semibold">@item.ControllerName</span>/@item.ActionName
                                    </td>
                                    <td>
                                        <span class="badge @(item.Metot == "POST" ? "bg-warning text-dark" : "bg-info text-dark")">@item.Metot</span>
                                    </td>
                                    <td class="text-nowrap">@item.IpAdresi</td>
                                    <td class="text-break text-muted small" style="max-width: 300px;">@item.Parametreler</td>
                        <td>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Log kaydı silinsin mi?');"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">Kayıtlı log bulunamadı.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Sayfalama -->
    @if (toplamSayfa > 1)
    {
        <nav class="mt-3">
            <ul class="pagination pagination-sm justify-content-center">
                <li class="page-item @(sayfa == 1 ? "disabled" : "")">
                    <a class="page-item" href="@Url.Action("Index", new { arama = ViewBag.Arama, rol = ViewBag.SeciliRol, metot = ViewBag.SeciliMetot, sayfa = sayfa - 1 })" class="page-link">Önceki</a>
                </li>
                @for (int i = 1; i <= toplamSayfa; i++)
                {
                    <li class="page-item @(sayfa == i ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { arama = ViewBag.Arama, rol = ViewBag.SeciliRol, metot = ViewBag.SeciliMetot, sayfa = i })">@i</a>
                    </li>
                }
                <li class="page-item @(sayfa == toplamSayfa ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { arama = ViewBag.Arama, rol = ViewBag.SeciliRol, metot = ViewBag.SeciliMetot, sayfa = sayfa + 1 })">Sonraki</a>
                </li>
            </ul>
        </nav>
    }
</div>

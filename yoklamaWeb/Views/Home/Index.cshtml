@{
    ViewData["Title"] = "Ana Sayfa";
}

<style>
    .role-selector-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 10px;
    }
    .role-card-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 12px 8px;
        background: #f8f9fa;
        border: 2px solid #e9ecef;
        border-radius: 12px;
        color: #495057;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
        text-align: center;
        gap: 6px;
        user-select: none;
    }
    .role-card-btn i {
        font-size: 1.25rem;
        color: #6c757d;
        transition: transform 0.2s ease, color 0.2s ease;
    }
    .role-card-btn:hover {
        background: #ffffff;
        border-color: #4f46e5;
        color: #4f46e5;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.12);
    }
    .role-card-btn:hover i {
        color: #4f46e5;
        transform: translateY(-2px);
    }
    .btn-check:checked + .role-card-btn {
        background: rgba(79, 70, 229, 0.08);
        border-color: #4f46e5;
        color: #4f46e5;
        font-weight: 700;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.18);
    }
    .btn-check:checked + .role-card-btn i {
        color: #4f46e5;
        transform: scale(1.1);
    }
</style>

<div class="container mt-5">
    @if (TempData["SuccessMessage"] != null)



    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (Context.Request.Query["timeout"] == "1")
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-clock-history me-2"></i> 30 dakika boyunca işlem yapmadığınız için oturumunuz otomatik olarak kapatılmıştır. Lütfen tekrar giriş yapın.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="card-title text-center mb-3">Sisteme Giriş</h2>
                    <p class="text-center text-muted mb-4">Rolünüzü seçin, ardından kullanıcı adı ve şifrenizle giriş
                        yapın.</p>
                        <!-- <p>pansiyon işlemleri için pansiyon görevlisi</p>
                         <p>sınav oluşturma düzenleme silme için ÖDM yetkilisi</p>
                         <p>sadece bir sınıfın yoklamasını almak için Gözetmen</p>
                          <p> her sınıfın yoklamasını almak için sınav Yetkilisi</p>
                         -->
                        
                     <button type="button" class="btn btn-outline-primary w-100 py-2.5 fw-bold shadow-sm" style="border-radius: 10px;" data-bs-toggle="modal" data-bs-target="#examHallSearchModal">
                         <i class="bi bi-search me-1"></i> Öğrenci Sınav Salonu Bul
                     </button>
                          

                    <form asp-controller="Account" asp-action="Login" method="post">
                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary mb-2">Rol Seçimi</label>
                            <div class="role-selector-grid">
                                <input type="radio" class="btn-check" name="role" id="rolePansiyonGorevlisi" value="PansiyonGorevlisi" checked />
                                <label class="role-card-btn" for="rolePansiyonGorevlisi">
                                    <i class="bi bi-house-door-fill"></i>
                                    <span>Pansiyon Görevlisi</span>
                                </label>

                                <input type="radio" class="btn-check" name="role" id="roleYoklamaci" value="Yoklamaci" />
                                <label class="role-card-btn" for="roleYoklamaci">
                                    <i class="bi bi-person-bounding-box"></i>
                                    <span>Gözetmen</span>
                                </label>

                                <input type="radio" class="btn-check" name="role" id="roleSinavYoneticisi" value="SinavYoneticisi" />
                                <label class="role-card-btn" for="roleSinavYoneticisi">
                                    <i class="bi bi-clipboard-check-fill"></i>
                                    <span>ÖDM Görevlisi</span>
                                </label>

                                <input type="radio" class="btn-check" name="role" id="roleSuperYoklamaci" value="SuperYoklamaci" />
                                <label class="role-card-btn" for="roleSuperYoklamaci">
                                    <i class="bi bi-star-fill"></i>
                                    <span>Sınav Yetkilisi</span>
                                </label>

                                <input type="radio" class="btn-check" name="role" id="roleGunlukYoklamaci" value="gunlukYoklamaci" />
                                <label class="role-card-btn" for="roleGunlukYoklamaci">
                                    <i class="bi bi-calendar-check-fill"></i>
                                    <span>Günlük Yoklama</span>
                                </label>

                                <input type="radio" class="btn-check" name="role" id="roleIdareci" value="Idareci" />
                                <label class="role-card-btn" for="roleIdareci">
                                    <i class="bi bi-person-badge-fill"></i>
                                    <span>İdareci</span>
                                </label>

                                <input type="radio" class="btn-check" name="role" id="roleAdmin" value="Admin" />
                                <label class="role-card-btn" for="roleAdmin">
                                    <i class="bi bi-shield-lock-fill"></i>
                                    <span>Yönetim</span>
                                </label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="username" class="form-label fw-semibold">Kullanıcı Adı</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                <input type="text" name="username" class="form-control" id="username"
                                    placeholder="Kullanıcı adınızı girin..." required />
                            </div>
                        </div>
                        <div class="mb-4">
                            <label for="password" class="form-label fw-semibold">Şifre</label>
                            <div class="input-group">
                                 <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                                 <input type="password" name="password" class="form-control" id="password"
                                     placeholder="Şifrenizi girin..." required />
                             </div>
                         </div>
                         <button type="submit" class="btn btn-primary w-100 py-2.5 fw-bold shadow-sm mb-3" style="border-radius: 10px;">
                             <i class="bi bi-box-arrow-in-right me-1"></i> Güvenli Giriş Yap
                         </button>
                     </form>
                     
                     <hr class="my-4" />
                     
                     <button type="button" class="btn btn-outline-primary w-100 py-2.5 fw-bold shadow-sm" style="border-radius: 10px;" data-bs-toggle="modal" data-bs-target="#examHallSearchModal">
                         <i class="bi bi-search me-1"></i> Öğrenci Sınav Salonu Bul
                     </button>
                 </div>
             </div>
         </div>
     </div>
 </div>

<!-- Modal -->
<div class="modal fade" id="examHallSearchModal" tabindex="-1" aria-labelledby="examHallSearchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius: 15px; overflow: hidden;">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="examHallSearchModalLabel">
                    <i class="bi bi-search me-2"></i> Öğrenci Sınav Salonu Bul
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-4">
                    <label for="searchStudentNo" class="form-label fw-bold">Öğrenci Numaranız</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person-badge"></i></span>
                        <input type="text" id="searchStudentNo" class="form-control form-control-lg" placeholder="Öğrenci numaranızı giriniz..." required />
                        <button type="button" id="btnSearchExamHall" class="btn btn-primary px-4">
                            Sorgula
                        </button>
                    </div>
                </div>

                <!-- Results container -->
                <div id="searchResultArea" style="display: none;">
                    <h6 class="fw-bold mb-3 text-secondary border-bottom pb-2">Sınav Yerleşim Sonuçları</h6>
                    <div id="searchResultsList" class="row g-3">
                        <!-- Dynamic results will be injected here -->
                    </div>
                </div>

                <!-- Alert container -->
                <div id="searchAlertArea" class="alert alert-warning mb-0" style="display: none;">
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btnSearch = document.getElementById("btnSearchExamHall");
        const inputStudentNo = document.getElementById("searchStudentNo");
        const resultArea = document.getElementById("searchResultArea");
        const resultsList = document.getElementById("searchResultsList");
        const alertArea = document.getElementById("searchAlertArea");

        function performSearch() {
            const studentNo = inputStudentNo.value.trim();
            if (!studentNo) {
                alertArea.innerText = "Lütfen öğrenci numaranızı giriniz.";
                alertArea.style.display = "block";
                resultArea.style.display = "none";
                return;
            }

            alertArea.style.display = "none";
            resultsList.innerHTML = `
                <div class="col-12 text-center py-3">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Yükleniyor...</span>
                    </div>
                    <p class="text-muted mt-2 mb-0">Aranıyor...</p>
                </div>
            `;
            resultArea.style.display = "block";

            // Make GET request
            fetch('@Url.Action("FindExamSeat", "Home")?studentNo=' + encodeURIComponent(studentNo))
            .then(response => response.json())
            .then(res => {
                if (res.success) {
                    alertArea.style.display = "none";
                    resultsList.innerHTML = "";
                    res.data.forEach(item => {
                        const cardHtml = `
                            <div class="col-md-6">
                                <div class="card h-100 border-0 shadow-sm bg-light" style="border-radius: 10px;">
                                    <div class="card-body">
                                        <h5 class="card-title text-primary fw-bold mb-1">${item.examName}</h5>
                                        <p class="text-muted small mb-3">
                                            <i class="bi bi-calendar3 me-1"></i> ${item.examDate} - ${item.examTime}
                                        </p>
                                        <div class="mb-2">
                                            <span class="text-muted small d-block">Öğrenci:</span>
                                            <strong class="text-dark">${item.studentName}</strong>
                                        </div>
                                        <div class="row g-2">
                                            <div class="col-6">
                                                <div class="p-2 bg-white rounded border text-center">
                                                    <span class="text-muted small d-block">Salon:</span>
                                                    <strong class="text-primary fs-6">${item.roomName}</strong>
                                                </div>
                                            </div>
                                            <div class="col-6">
                                                <div class="p-2 bg-white rounded border text-center">
                                                    <span class="text-muted small d-block">Sıra / Koltuk:</span>
                                                    <strong class="text-success fs-6">Sıra: ${item.sira} / No: ${item.seatNumber}</strong>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                        resultsList.insertAdjacentHTML('beforeend', cardHtml);
                    });
                } else {
                    resultsList.innerHTML = "";
                    resultArea.style.display = "none";
                    alertArea.innerText = res.message;
                    alertArea.style.display = "block";
                }
            })
            .catch(error => {
                console.error(error);
                resultsList.innerHTML = "";
                resultArea.style.display = "none";
                alertArea.innerText = "Bir hata oluştu. Lütfen tekrar deneyin.";
                alertArea.style.display = "block";
            });
        }

        btnSearch.addEventListener("click", performSearch);
        inputStudentNo.addEventListener("keypress", function (e) {
            if (e.key === "Enter") {
                performSearch();
            }
        });
    });
</script>
